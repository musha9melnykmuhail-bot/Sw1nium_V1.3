function __SW_MakeCornerLines()
    local t = {}
    for i = 1, 8 do
        t[i] = __SW_SafeDrawing("Line", {Thickness = 1, Transparency = 1, Visible = false, Color = Color3.new(1,1,1)})
    end
    return t
end

function __SW_HideAllESP(obj)
    if not obj then return end
    if S.hasDrawing then
        if obj.Box and obj.Box.Visible then obj.Box.Visible = false end
        if obj.CornerLines then
            for i = 1, #obj.CornerLines do local l = obj.CornerLines[i]; if l and l.Visible then l.Visible = false end end
        end
        if obj.Box3D then
            for i = 1, #obj.Box3D do local l = obj.Box3D[i]; if l and l.Visible then l.Visible = false end end
        end
        if obj.Tracer and obj.Tracer.Visible then obj.Tracer.Visible = false end
        if obj.NameTag and obj.NameTag.Visible then obj.NameTag.Visible = false end
        if obj.RoleTag and obj.RoleTag.Visible then obj.RoleTag.Visible = false end
        if obj.DistanceTag and obj.DistanceTag.Visible then obj.DistanceTag.Visible = false end
        if obj.HealthBar and obj.HealthBar.Visible then obj.HealthBar.Visible = false end
        if obj.HealthBarBg and obj.HealthBarBg.Visible then obj.HealthBarBg.Visible = false end
        if obj.HealthText and obj.HealthText.Visible then obj.HealthText.Visible = false end
        if obj.SkeletonLines then
            for i = 1, #obj.SkeletonLines do local l = obj.SkeletonLines[i]; if l and l.Visible then l.Visible = false end end
        end
        if obj.Arrow and obj.Arrow.Visible then obj.Arrow.Visible = false end
    end
end

function __SW_ClearChams(obj)
    if not obj then return end
    for _, key in ipairs({"ChamsFill", "ChamsOutline", "ChamsWire", "ChamsGlow", "ChamsPulse"}) do
        local g = obj[key]
        if g then
            for i, inst in pairs(g) do
                pcall(function() inst:Destroy() end)
                g[i] = nil
            end
            obj[key] = nil
        end
    end
end

function __SW_RemoveESPForPlayer(plr)
    local obj = ESP.Objects[plr]
    if not obj then return end
    __SW_ClearChams(obj)
    for _, v in pairs(obj) do
        if type(v) == "table" then
            for _, vv in pairs(v) do
                pcall(function() vv:Remove() end)
                pcall(function() vv:Destroy() end)
            end
        else
            pcall(function() v:Remove() end)
            pcall(function() v:Destroy() end)
        end
    end
    ESP.Objects[plr] = nil
end

function ESP.FullCleanup()
    for _, obj in pairs(ESP.Objects) do
        __SW_HideAllESP(obj)
        __SW_ClearChams(obj)
    end
    for plr in pairs(ESP.Objects) do
        __SW_RemoveESPForPlayer(plr)
    end
    ESP.Objects = {}
end

function __SW_CreateESPForPlayer(plr)
    if plr == LocalPlayer or ESP.Objects[plr] then return end
    if not plr.Character then return end
    if not plr.Character:FindFirstChild("Head") then return end
    local obj = {}
    if S.hasDrawing then
        obj.Box = __SW_SafeDrawing("Square", {Thickness = 1, Filled = false, Transparency = 1, Color = Color3.new(1,1,1), Visible = false})
        obj.CornerLines = __SW_MakeCornerLines()
        obj.Box3D = {}
        for i = 1, 12 do
            obj.Box3D[i] = __SW_SafeDrawing("Line", {Thickness = 1, Transparency = 1, Color = Color3.new(1,1,1), Visible = false})
        end
        obj.Tracer = __SW_SafeDrawing("Line", {Thickness = 1, Transparency = 1, Color = Color3.new(1,1,1), Visible = false})
        obj.NameTag = __SW_SafeDrawing("Text", {Size = ESP.NameSize, Center = true, Outline = true, Color = Color3.new(1,1,1), Visible = false})
        obj.RoleTag = __SW_SafeDrawing("Text", {Size = 11, Center = true, Outline = true, Color = Color3.new(1,1,1), Visible = false})
        obj.DistanceTag = __SW_SafeDrawing("Text", {Size = 11, Center = true, Outline = true, Color = ESP.DistanceColor, Visible = false})
        obj.HealthBar = __SW_SafeDrawing("Square", {Filled = true, Transparency = 1, Color = ESP.HealthColor, Visible = false})
        obj.HealthBarBg = __SW_SafeDrawing("Square", {Filled = true, Transparency = 0.5, Color = Color3.fromRGB(20,20,20), Visible = false})
        obj.HealthText = __SW_SafeDrawing("Text", {Size = 11, Center = true, Outline = true, Color = ESP.HealthColor, Visible = false})
        obj.SkeletonLines = {}
        for i = 1, 14 do
            obj.SkeletonLines[i] = __SW_SafeDrawing("Line", {Thickness = ESP.SkeletonThickness, Transparency = 1, Color = Color3.new(1,1,1), Visible = false})
        end

        if HAS_TRIANGLE then
            obj.Arrow = __SW_SafeDrawing("Triangle", {Thickness = 1, Filled = true, Transparency = 0, Color = ESP.ArrowColor, Visible = false})
        else
            obj.Arrow = nil
        end
    end
    obj._character = plr.Character
    ESP.Objects[plr] = obj
end

function __SW_ApplyChams(plr, char)
    local obj = ESP.Objects[plr]
    if not obj then return end
    __SW_ClearChams(obj)
    local role = __SW_DetectRole(plr)
    local roleColors = ESP.Colors[role] or ESP.Colors.Unknown
    local color = ESP.UseRoleColors and roleColors.Chams or Color3.fromRGB(150, 100, 255)
    local trans = ESP.ChamsTransparency
    local ctype = ESP.ChamsType
    local parts = {}
    for _, p in ipairs(char:GetChildren()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            table.insert(parts, p)
        end
    end
    if ctype == "Fill" then
        obj.ChamsFill = {}
        for _, p in ipairs(parts) do
            local hl = Instance.new("Highlight")
            hl.FillColor = color
            hl.FillTransparency = trans
            hl.OutlineColor = color
            hl.OutlineTransparency = 1
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = p
            hl.Parent = ESP.Gui or CoreGui
            table.insert(obj.ChamsFill, hl)
        end
    elseif ctype == "Outline" then
        obj.ChamsOutline = {}
        for _, p in ipairs(parts) do
            local hl = Instance.new("Highlight")
            hl.FillTransparency = 1
            hl.OutlineColor = color
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = p
            hl.Parent = ESP.Gui or CoreGui
            table.insert(obj.ChamsOutline, hl)
        end
    elseif ctype == "Wireframe" then
        obj.ChamsWire = {}
        for _, p in ipairs(parts) do
            local sb = Instance.new("SelectionBox")
            sb.Color3 = color
            sb.LineThickness = 0.05
            sb.Adornee = p
            sb.SurfaceTransparency = 1
            sb.Parent = ESP.Gui or CoreGui
            table.insert(obj.ChamsWire, sb)
        end
    elseif ctype == "Glow" then
        obj.ChamsGlow = {}
        for _, p in ipairs(parts) do
            local hl = Instance.new("Highlight")
            hl.FillColor = color
            hl.FillTransparency = 0.85
            hl.OutlineColor = color
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = p
            hl.Parent = ESP.Gui or CoreGui
            table.insert(obj.ChamsGlow, hl)
        end
    elseif ctype == "Pulse" or ctype == "Metallic" or ctype == "Galaxy"
        or ctype == "Magma" or ctype == "Electric" or ctype == "Glass" or ctype == "Obsidian"
        or ctype == "Mist" then
        obj.ChamsPulse = {}
        local fillColor, outlineColor = color, color
        local fillTransparency = math.clamp(tonumber(trans) or 0.5, 0, 1)
        local outlineTransparency = 0.05
        if ctype == "Metallic" then
            fillColor = Color3.fromRGB(185, 195, 210)
            outlineColor = Color3.fromRGB(245, 248, 255)
            fillTransparency = math.max(fillTransparency, 0.32)
        elseif ctype == "Galaxy" then
            fillColor = Color3.fromRGB(125, 70, 220)
            outlineColor = Color3.fromRGB(60, 210, 255)
            fillTransparency = math.max(fillTransparency, 0.22)
        elseif ctype == "Magma" then
            fillColor = Color3.fromRGB(255, 65, 20)
            outlineColor = Color3.fromRGB(255, 190, 45)
            fillTransparency = math.min(fillTransparency, 0.3)
        elseif ctype == "Electric" then
            fillColor = Color3.fromRGB(65, 160, 255)
            outlineColor = Color3.fromRGB(220, 250, 255)
            fillTransparency = math.max(fillTransparency, 0.38)
        elseif ctype == "Glass" then
            fillColor = Color3.fromRGB(150, 220, 255)
            outlineColor = Color3.fromRGB(225, 250, 255)
            fillTransparency = math.max(fillTransparency, 0.72)
        elseif ctype == "Obsidian" then
            fillColor = Color3.fromRGB(30, 24, 48)
            outlineColor = Color3.fromRGB(150, 110, 205)
            fillTransparency = math.min(fillTransparency, 0.22)
        elseif ctype == "Mist" then
            fillColor = Color3.fromRGB(185, 205, 220)
            outlineColor = Color3.fromRGB(225, 235, 245)
            fillTransparency = math.max(fillTransparency, 0.62)
        elseif ctype == "Glow" then
            fillTransparency = math.max(fillTransparency, 0.72)
        elseif ctype == "Pulse" then
            fillTransparency = math.min(math.max(fillTransparency, 0.3), 0.65)
        end
        for _, p in ipairs(parts) do
            local hl = Instance.new("Highlight")
            hl.Name = "Sw1niumChams_" .. tostring(ctype)
            hl.FillColor = fillColor
            hl.FillTransparency = fillTransparency
            hl.OutlineColor = outlineColor
            hl.OutlineTransparency = outlineTransparency
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = p
            hl.Parent = ESP.Gui or CoreGui
            table.insert(obj.ChamsPulse, hl)
        end
    end
end

local Camera = workspace.CurrentCamera
function __SW_WorldToScreen(worldPos)
    local sp, onScreen = Camera:WorldToViewportPoint(worldPos)
    return Vector2.new(sp.X, sp.Y), onScreen
end

