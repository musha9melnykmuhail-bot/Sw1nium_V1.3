function __SW_SafeDrawing(class, props)
    if not S.hasDrawing then return nil end
    local ok, obj = pcall(function() return Drawing.new(class) end)
    if not ok or not obj then return nil end
    if props then for k, v in pairs(props) do pcall(function() obj[k] = v end) end end
    return obj
end


function __SW_SupportsTriangle()
    if not S.hasDrawing then return false end
    local ok, obj = pcall(function() return Drawing.new("Triangle") end)
    if not ok or not obj then return false end
    pcall(function() obj:Remove() end)
    return true
end
