function __SW_ShowNotification(titleText, stateOrStyle)
    if S.ElementManager and S.ElementManager.Notifications == false then return end
    local key = tostring(titleText) .. "_" .. tostring(stateOrStyle)
    local now = os.clock()
    if _notifyCooldown[key] and (now - _notifyCooldown[key]) < 0.15 then return end
    _notifyCooldown[key] = now

    local styleName, statusSuffix = "Info", ""
    if type(stateOrStyle) == "boolean" then
        styleName = stateOrStyle and "Success" or "Warning"
        statusSuffix = stateOrStyle and " > ON" or " > OFF"
    elseif type(stateOrStyle) == "string" and NOTIFY_STYLES[stateOrStyle] then
        styleName = stateOrStyle
    end
    local style = NOTIFY_STYLES[styleName]

    local toast = Instance.new("CanvasGroup", NotifyContainer)
    toast.Size = UDim2.new(0, 210, 0, 36)
    toast.BackgroundColor3 = C_BG
    toast.BorderSizePixel = 0
    toast.GroupTransparency = 1
    toast.ClipsDescendants = true
