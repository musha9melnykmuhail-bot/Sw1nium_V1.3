S.InitWeaponESP = function()
S.WeaponIsCandidate = function(inst)
    if not inst or not inst:IsA("Tool") then return false end
    local n = inst.Name:lower()
    return n:find("knife", 1, true)
        or n:find("gun", 1, true)
        or n:find("revolver", 1, true)
        or n:find("weapon", 1, true)
end

S.WeaponClearObject = function(inst)
    local data = S.WeaponState.Objects[inst]
    if not data then return end
    for _, obj in ipairs(data) do
        if typeof(obj) == "Instance" then
            pcall(function() obj:Destroy() end)
        end
    end
    S.WeaponState.Objects[inst] = nil
end

S.WeaponClearAll = function()
    for inst in pairs(S.WeaponState.Objects) do
        S.WeaponClearObject(inst)
    end
    S.WeaponState.Objects = {}
end

S.WeaponGetHandle = function(inst)
    return inst and (inst:FindFirstChild("Handle") or inst:FindFirstChildWhichIsA("BasePart", true))
end

S.WeaponBuildObject = function(inst, handle)
    local created = {}
    local cam = workspace.CurrentCamera
    if not cam then return nil end

    if S.WeaponState.Highlight then
        local hl = Instance.new("Highlight")
        hl.Name = "Sw1niumWeaponHighlight"
        hl.Adornee = handle
        hl.FillColor = Color3.fromRGB(255, 190, 70)
        hl.FillTransparency = 0.65
        hl.OutlineColor = Color3.fromRGB(255, 220, 130)
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = inst
        table.insert(created, hl)
    end

    if S.WeaponState.Names or S.WeaponState.Distance then
        local gui = Instance.new("BillboardGui")
        gui.Name = "Sw1niumWeaponInfo"
        gui.Adornee = handle
        gui.Size = UDim2.new(0, 150, 0, 32)
        gui.StudsOffset = Vector3.new(0, 2.2, 0)
        gui.AlwaysOnTop = true
        gui.Parent = handle
        table.insert(created, gui)

        local label = Instance.new("TextLabel", gui)
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.BuilderSansBold
        label.TextColor3 = Color3.fromRGB(255, 210, 120)
        label.TextSize = 11
        label.TextStrokeTransparency = 0.5
        label.TextWrapped = true
        table.insert(created, label)
    end

    return created
end

S.WeaponUpdateText = function(inst, data, distance)
    if not data then return end
    local label
    for _, obj in ipairs(data) do
        if typeof(obj) == "Instance" and obj:IsA("TextLabel") then
            label = obj
            break
        end
    end
    if not label then return end

    local text = ""
    if S.WeaponState.Names then text = inst.Name end
    if S.WeaponState.Distance then
        local d = math.floor(distance + 0.5)
        text = text ~= "" and (text .. "  [" .. d .. "m]") or ("[" .. d .. "m]")
    end
    label.Text = text
end

S.WeaponApply = function(inst)
    if not S.WeaponIsCandidate(inst) or not S.WeaponState.Enabled then return end

    local character = LocalPlayer.Character
    if S.WeaponState.DroppedOnly and character and inst:IsDescendantOf(character) then
        S.WeaponClearObject(inst)
        return
    end

    local handle = S.WeaponGetHandle(inst)
    if not handle then return end

    local cam = workspace.CurrentCamera
    if not cam then return end
    local distance = (cam.CFrame.Position - handle.Position).Magnitude
    if distance > S.WeaponState.MaxDistance then
        S.WeaponClearObject(inst)
        return
    end

    local existing = S.WeaponState.Objects[inst]
    if existing and existing._handle ~= handle then
        S.WeaponClearObject(inst)
        existing = nil
    end

    if not existing then
        local created = S.WeaponBuildObject(inst, handle)
        if not created then return end
        created._handle = handle
        S.WeaponState.Objects[inst] = created
        existing = created
    end

    S.WeaponUpdateText(inst, existing, distance)
end

S.WeaponUpdateTracked = function()
    if not S.WeaponState.Enabled then
        S.WeaponClearAll()
        return
    end

    for inst in pairs(S.WeaponState.Objects) do
        if not inst or not inst.Parent then
            S.WeaponClearObject(inst)
        else
            local character = LocalPlayer.Character
            if S.WeaponState.DroppedOnly and character and inst:IsDescendantOf(character) then
                S.WeaponClearObject(inst)
            else
                local handle = S.WeaponGetHandle(inst)
                local cam = workspace.CurrentCamera
                if not handle or not cam or (cam.CFrame.Position - handle.Position).Magnitude > S.WeaponState.MaxDistance then
                    S.WeaponClearObject(inst)
                else
                    S.WeaponApply(inst)
                end
            end
        end
    end
end

S.weaponScanBusy = false
S.WeaponScan = function()
    if S.weaponScanBusy then return end
    if not S.WeaponState.Enabled then
        S.WeaponClearAll()
        return
    end

    S.weaponScanBusy = true
    -- One discovery pass when requested; steady-state updates never call GetDescendants.
    local descendants = workspace:GetDescendants()
    local processed = 0
    for i = 1, #descendants do
        local inst = descendants[i]
        if S.WeaponIsCandidate(inst) then
            pcall(function() S.WeaponApply(inst) end)
        end
        processed = processed + 1
        if processed % 250 == 0 then task.wait() end
    end

    S.WeaponUpdateTracked()
    S.weaponScanBusy = false
end

S.WeaponRebuild = function()
    S.WeaponClearAll()
    S.WeaponScan()
end

workspace.DescendantAdded:Connect(function(inst)
    if not S.WeaponState.Enabled or not S.WeaponIsCandidate(inst) then return end
    task.defer(function()
        if S.WeaponState.Enabled and inst.Parent then
            pcall(function() S.WeaponApply(inst) end)
        end
    end)
end)

workspace.DescendantRemoving:Connect(function(inst)
    if S.WeaponState.Objects[inst] then
        S.WeaponClearObject(inst)
    end
end)

S.SetWeaponESP = function(enabled)
    S.WeaponState.Enabled = enabled
    if enabled then
        task.spawn(function()
            S.WeaponScan()
        end)
    else
        S.WeaponClearAll()
    end
end

task.spawn(function()
    while task.wait(math.max(0.10, S.WeaponState.ScanInterval)) do
        if S.WeaponState.Enabled then
            pcall(S.WeaponUpdateTracked)
        end
    end
end)

end

