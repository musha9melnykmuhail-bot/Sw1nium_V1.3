        KeybindPanelSearch.Text = focusName or ""
        KeybindPanel.Visible = true
        refresh(focusName or "")
    end
    KeybindPanelSearch:GetPropertyChangedSignal("Text"):Connect(function()
        refresh(KeybindPanelSearch.Text)
    end)
end

