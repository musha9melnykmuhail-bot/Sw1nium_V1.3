    -- Keep 3D dance previews running for every card currently visible in the grid,
    -- not just the card under the mouse. Off-screen previews are stopped to avoid
    -- cloning the avatar and running all 115 animations at once.
    local previewUpdateToken = 0
    local previewScanQueued = false
    local function updateVisibleEmotePreviews()
        -- Coalesce wheel/touch scroll events and build previews in small batches.
        -- All visible cards still animate; the expensive clone/LoadAnimation work is spread out.
        previewUpdateToken += 1
        local thisToken = previewUpdateToken
        if previewScanQueued then return end
        previewScanQueued = true
        task.delay(0.12, function()
            previewScanQueued = false
            if thisToken ~= previewUpdateToken then
                updateVisibleEmotePreviews()
                return
            end
            local pageVisible = emotePage.Visible and currentSkinSub == "Emotes"
            local top = emoteScroll.AbsolutePosition.Y
            local bottom = top + emoteScroll.AbsoluteSize.Y
            local left = emoteScroll.AbsolutePosition.X
            local right = left + emoteScroll.AbsoluteSize.X
            local visibleEntries = {}
            for _, entry in ipairs(emoteButtons) do
                local card = entry.Button
                local pos = card.AbsolutePosition
                local size = card.AbsoluteSize
                local onScreen = pageVisible and card.Visible and size.X > 0 and size.Y > 0
                    and pos.Y + size.Y >= top and pos.Y <= bottom
                    and pos.X + size.X >= left and pos.X <= right
                if onScreen then
                    visibleEntries[#visibleEntries + 1] = entry
                elseif entry.PreviewActive() then
                    entry.ClearPreview()
                end
            end
            -- No arbitrary 2/4-rig cap: every card currently inside the scroll
            -- viewport may preview. Keep the work staggered to avoid a frame spike.
            for index, entry in ipairs(visibleEntries) do
                if not entry.PreviewActive() then
                    task.delay((index - 1) * 0.065, function()
                        if thisToken ~= previewUpdateToken then return end
                        if not (emotePage.Visible and currentSkinSub == "Emotes") then return end
                        local card = entry.Button
                        local pos, size = card.AbsolutePosition, card.AbsoluteSize
                        local nowTop = emoteScroll.AbsolutePosition.Y
                        local nowBottom = nowTop + emoteScroll.AbsoluteSize.Y
                        local nowLeft = emoteScroll.AbsolutePosition.X
                        local nowRight = nowLeft + emoteScroll.AbsoluteSize.X
                        local stillVisible = card.Visible and size.X > 0 and size.Y > 0
                            and pos.Y + size.Y >= nowTop and pos.Y <= nowBottom
                            and pos.X + size.X >= nowLeft and pos.X <= nowRight
                        if stillVisible then entry.ShowPreview() end
                    end)
                end
            end
        end)
    end

