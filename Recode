local MM2 = {
    Innocent = Color3.fromRGB(80, 220, 120),
    Sheriff = Color3.fromRGB(80, 150, 255),
    Murderer = Color3.fromRGB(255, 70, 70),
    Unknown = Color3.new(1,1,1),
    RoleCache = {},
}
function __SW_DetectRole(plr)
    if not plr or not plr.Parent then return "Unknown" end
    local cached = MM2.RoleCache[plr]
    if cached and (tick() - cached.time) < 0.75 then return cached.role end
    local backpack = plr:FindFirstChild("Backpack")
    local char = plr.Character
    local hasKnife, hasGun = false, false
    if backpack then
        if backpack:FindFirstChild("Knife") then hasKnife = true end
        if backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver") then hasGun = true end
    end
    if char then
        if char:FindFirstChild("Knife") then hasKnife = true end
        if char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") then hasGun = true end
    end
    local role = "Innocent"
    if hasKnife then role = "Murderer" elseif hasGun then role = "Sheriff" end
    MM2.RoleCache[plr] = {role = role, time = tick()}
    return role
end
function __SW_GetRoleColor(role)
    if role == "Murderer" then return MM2.Murderer end
    if role == "Sheriff" then return MM2.Sheriff end
    if role == "Innocent" then return MM2.Innocent end
    return MM2.Unknown
end




