-- Apple-like quick search: animated header expansion, live results, and direct navigation.
local searchOpen = false
local searchAnimationBusy = false
local searchIndex = {}
local currentSearchMatches = {}
local function searchTween(obj, duration, props)
    local tw = TweenService:Create(obj, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end
local function clearSearchResults()
    for _, child in ipairs(SearchResultsScroll:GetChildren()) do
        if child:IsA("GuiObject") and child ~= SearchResultsLayout and child ~= SearchResultsPadding then
            child:Destroy()
        end
    end
end
local function rebuildSearchIndex()
    searchIndex = {}
    local seen = {}
    for tabName, data in pairs(Pages) do
        if data.Page then
            for _, obj in ipairs(data.Page:GetDescendants()) do
                local value = nil
                if obj:IsA("TextLabel") or obj:IsA("TextButton") then value = obj.Text end
                if value and value ~= "" and #value >= 2 and #value <= 72 then
                    local trimmed = value:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
                    local key = string.lower(tabName .. "|" .. trimmed)
                    if trimmed ~= "" and not seen[key] and not obj:IsDescendantOf(SearchResults) then
                        seen[key] = true
                        table.insert(searchIndex, {Label = trimmed, Lower = string.lower(trimmed), Tab = tabName, Target = obj})
                    end
                end
            end
        end
    end
end
local function activateSearchResult(entry)
    if not entry or not entry.Target or not entry.Target.Parent then return end
    local tabData = Pages[entry.Tab]
    if not tabData then return end
    -- Reveal the appropriate nested customization page if the result lives in a subtab.
    local target = entry.Target
    local pathNodes = {}
    local node = target
    while node and node ~= tabData.Page do
        table.insert(pathNodes, node)
        node = node.Parent
    end
    for _, candidate in ipairs(pathNodes) do
        if candidate:IsA("GuiObject") and candidate.Name:match("SubPage$") then
            local subName = candidate.Name:gsub("SubPage$", "")
            if entry.Tab == "Visuals" and S.SwitchVisualSubTab then
                S.SwitchVisualSubTab(subName)
            elseif entry.Tab == "Setting" and S.SwitchSettingsSubTab then
                S.SwitchSettingsSubTab(subName == "Customization" and "Customization" or (subName == "Skins" and "Skins" or "Menu"))
            else
                local parent = candidate.Parent
                for _, sibling in ipairs(parent:GetChildren()) do
                    if sibling:IsA("GuiObject") and sibling.Name:match("SubPage$") then sibling.Visible = (sibling == candidate) end
                end
            end
        end
    end
    __SW_SwitchTab(entry.Tab)
    SearchResults.Visible = false
    SearchBackdrop.Visible = false
    pcall(function()
        if ScreenBlur and ScreenBlur.Parent and ScreenBlur.Enabled then
            TweenService:Create(ScreenBlur, TweenInfo.new(0.22), {Size = S.MenuStyle.BackgroundBlurSize or 14}):Play()
        end
    end)
    SearchBox:ReleaseFocus()
    task.delay(0.28, function()
        if not target or not target.Parent then return end
        local scroll = target.Parent
        while scroll and scroll ~= tabData.Page and not scroll:IsA("ScrollingFrame") do scroll = scroll.Parent end
        if scroll and scroll:IsA("ScrollingFrame") then
            local y = math.max(0, target.AbsolutePosition.Y - scroll.AbsolutePosition.Y + scroll.CanvasPosition.Y - 22)
            searchTween(scroll, 0.28, {CanvasPosition = Vector2.new(scroll.CanvasPosition.X, y)})
        end
        local highlight = target:IsA("GuiObject") and target or nil
        if highlight then
            local original = highlight.BackgroundColor3
            if highlight:IsA("TextButton") or highlight:IsA("TextLabel") then
                local oldColor = highlight.TextColor3
                searchTween(highlight, 0.22, {TextColor3 = C_ACCENT})
                task.delay(0.55, function() if highlight and highlight.Parent then searchTween(highlight, 0.30, {TextColor3 = oldColor}) end end)
            elseif highlight.BackgroundTransparency < 1 then
                searchTween(highlight, 0.18, {BackgroundColor3 = C_ACCENT})
                task.delay(0.45, function() if highlight and highlight.Parent then searchTween(highlight, 0.28, {BackgroundColor3 = original}) end end)
            end
        end
    end)
end
local function refreshSearchResults(query)
    clearSearchResults()
    query = string.lower((query or ""):gsub("^%s+", ""):gsub("%s+$", ""))
    if query == "" then
        currentSearchMatches = {}
        SearchResultsTitle.Text = "QUICK FIND  ·  TYPE TO SEARCH"
        SearchResults.Size = UDim2.new(0, 330, 0, 8)
        SearchResults.Visible = false
        SearchBackdrop.Visible = false
        pcall(function()
            if ScreenBlur and ScreenBlur.Parent and ScreenBlur.Enabled then
                TweenService:Create(ScreenBlur, TweenInfo.new(0.18), {Size = S.MenuStyle.BackgroundBlurSize or 14}):Play()
            end
        end)
        return
    end
    local matches = {}
    for _, entry in ipairs(searchIndex) do
        if entry.Lower:find(query, 1, true) then
            table.insert(matches, entry)
        end
    end
    currentSearchMatches = matches
    SearchResultsTitle.Text = (#matches > 0 and ("RESULTS  ·  " .. #matches) or "NO MATCHES FOUND")
    for i, entry in ipairs(matches) do
        local row = Instance.new("TextButton", SearchResultsScroll)
        row.Name = "SearchResult_" .. i
        row.Size = UDim2.new(1, -4, 0, 34)
        row.BackgroundColor3 = C_BG
        row.BackgroundTransparency = 0.24
        row.BorderSizePixel = 0
        row.AutoButtonColor = false
        row.Text = ""
        row.LayoutOrder = i
        row.ZIndex = 73
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
        local label = Instance.new("TextLabel", row)
        label.Size = UDim2.new(1, -84, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = entry.Label
        label.TextColor3 = C_HEADER_TEXT
        label.Font = Enum.Font.BuilderSansMedium
        label.TextSize = 11
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextTruncate = Enum.TextTruncate.AtEnd
        label.ZIndex = 74
        local category = Instance.new("TextLabel", row)
        category.Size = UDim2.new(0, 70, 1, 0)
        category.Position = UDim2.new(1, -78, 0, 0)
        category.BackgroundTransparency = 1
        category.Text = entry.Tab
        category.TextColor3 = C_ACCENT
        category.Font = Enum.Font.BuilderSansMedium
        category.TextSize = 9
        category.TextXAlignment = Enum.TextXAlignment.Right
        category.ZIndex = 74
        row.MouseEnter:Connect(function() searchTween(row, 0.14, {BackgroundTransparency = 0.02}) end)
        row.MouseLeave:Connect(function() searchTween(row, 0.16, {BackgroundTransparency = 0.24}) end)
        row.MouseButton1Click:Connect(function() activateSearchResult(entry) end)
    end
    local resultHeight = math.min(#matches, 8) * 37 + 43
    local availableHeight = math.max(180, math.min(menuHeight - 70, 460))
    resultHeight = math.min(math.max(76, resultHeight), availableHeight)
    SearchResults.Size = UDim2.new(0, math.min(460, math.max(300, menuWidth - 220)), 0, resultHeight)
    SearchResults.Visible = true
    SearchBackdrop.Visible = true
    SearchResults.BackgroundTransparency = 1
    pcall(function()
        if ScreenBlur and ScreenBlur.Parent and ScreenBlur.Enabled then
            TweenService:Create(ScreenBlur, TweenInfo.new(0.18), {Size = math.max(18, S.MenuStyle.BackgroundBlurSize or 14)}):Play()
        end
    end)
    searchTween(SearchResults, 0.18, {BackgroundTransparency = 0.02})
end
local function openSearch()
    if searchOpen then
        SearchBox:CaptureFocus()
        return
    end
    if searchAnimationBusy then return end
    searchAnimationBusy = true
    searchOpen = true
    SearchBox.Visible = true
    SearchCloseButton.Visible = true
    SearchResults.Visible = SearchBox.Text ~= ""
    SearchFrame.Position = UDim2.new(1, -146, 0, 10)
    SearchFrame.Size = UDim2.new(0, 28, 0, 28)
    local tw = searchTween(SearchFrame, 0.30, {Position = UDim2.new(0, 200, 0, 10), Size = UDim2.new(1, -354, 0, 28)})
    searchTween(sStroke, 0.22, {Color = C_ACCENT})
    tw.Completed:Connect(function()
        searchAnimationBusy = false
        SearchBox:CaptureFocus()
        refreshSearchResults(SearchBox.Text)
    end)
end
local function closeSearch(clearText)
    if not searchOpen or searchAnimationBusy then return end
    searchAnimationBusy = true
    searchOpen = false
    SearchResults.Visible = false
    SearchBackdrop.Visible = false
    pcall(function()
        if ScreenBlur and ScreenBlur.Parent and ScreenBlur.Enabled then
            TweenService:Create(ScreenBlur, TweenInfo.new(0.22), {Size = S.MenuStyle.BackgroundBlurSize or 14}):Play()
        end
    end)
    SearchBox:ReleaseFocus()
    if clearText then SearchBox.Text = "" end
    SearchCloseButton.Visible = false
    local tw = searchTween(SearchFrame, 0.26, {Position = UDim2.new(1, -146, 0, 10), Size = UDim2.new(0, 28, 0, 28)})
    searchTween(sStroke, 0.20, {Color = C_BORDER})
    tw.Completed:Connect(function()
        if not searchOpen then SearchBox.Visible = false end
        searchAnimationBusy = false
    end)
end
SearchIcon.MouseButton1Click:Connect(openSearch)
SearchCloseButton.MouseButton1Click:Connect(function() closeSearch(true) end)
SearchBox:GetPropertyChangedSignal("Text"):Connect(function() if searchOpen then refreshSearchResults(SearchBox.Text) end end)
SearchBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        if currentSearchMatches[1] then activateSearchResult(currentSearchMatches[1]) end
    elseif SearchBox.Text == "" then
        SearchResults.Visible = false
        SearchBackdrop.Visible = false
    end
end)
