    local weaponFinishes = {
        Default = {color = nil, material = nil},
        Crimson = {color = Color3.fromRGB(220, 45, 65), material = Enum.Material.SmoothPlastic},
        Ice = {color = Color3.fromRGB(100, 215, 255), material = Enum.Material.Glass},
        Galaxy = {color = Color3.fromRGB(150, 95, 255), material = Enum.Material.Neon},
        Toxic = {color = Color3.fromRGB(130, 255, 70), material = Enum.Material.Neon},
        Gold = {color = Color3.fromRGB(255, 195, 55), material = Enum.Material.Metal},
        Shadow = {color = Color3.fromRGB(35, 35, 45), material = Enum.Material.Metal},
    }
    local function restoreWeaponParts()
        for part, original in pairs(weaponOriginals) do
            if part and part.Parent then
                pcall(function() part.Color = original.Color; part.Material = original.Material; part.Reflectance = original.Reflectance end)
            end
        end
        currentWeaponFinish = "Default"
    end
    local function applyWeaponFinish(name)
        local finish = weaponFinishes[name]
        if not finish then return end
        if name == "Default" then
            restoreWeaponParts()
            if weaponStatus then weaponStatus.Text = "Finish reset on this client." end
            return
        end
        local character = LocalPlayer and LocalPlayer.Character
        local toolCount, partCount = 0, 0
        if character then
            for _, child in ipairs(character:GetChildren()) do
                if child:IsA("Tool") then
                    toolCount = toolCount + 1
                    for _, part in ipairs(child:GetDescendants()) do
                        if part:IsA("BasePart") then
                            if not weaponOriginals[part] then
                                weaponOriginals[part] = {Color = part.Color, Material = part.Material, Reflectance = part.Reflectance}
                            end
                            part.Color = finish.color
                            part.Material = finish.material
                            if name == "Ice" then part.Reflectance = 0.15 elseif name == "Gold" then part.Reflectance = 0.08 else part.Reflectance = 0 end
                            partCount = partCount + 1
                        end
                    end
                end
            end
        end
        currentWeaponFinish = name
        if weaponStatus then
            weaponStatus.Text = toolCount > 0 and (name .. " applied locally • " .. partCount .. " parts changed") or "Equip your MM2 knife/gun, then select a finish."
        end
    end
