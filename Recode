        radioId = tostring(id or ""):match("(%d+)") or ""
        if radioId == "" then
            setRadioStatus("Invalid Sound ID", false)
            return
        end
        pcall(function()
            if __SW_RadioSound then __SW_RadioSound:Stop(); __SW_RadioSound:Destroy() end
            local sound = Instance.new("Sound")
            sound.Name = "Sw1niumRadioSound"
            sound.SoundId = "rbxassetid://" .. radioId
            sound.Volume = radioVolume
            sound.Looped = false
            local eq = Instance.new("EqualizerSoundEffect")
            eq.Name = "Sw1niumBassEQ"
            eq.LowGain = radioVolume > 1 and 8 or 3
            eq.MidGain = 0
            eq.HighGain = 1
            eq.Parent = sound
            sound.Parent = game:GetService("SoundService")
            __SW_RadioSound = sound
            miniPaused = false
            miniPlay.Text = "Ⅱ"
            updateMiniTrack(title or radioId, radioId)
            setRadioStatus("LOADING  •  " .. tostring(title or radioId), true)
            task.spawn(function()
                local ok = pcall(function()
                    game:GetService("ContentProvider"):PreloadAsync({sound})
                end)
                if __SW_RadioSound ~= sound then return end
                if ok and sound.IsLoaded then
                    sound:Play()
                    miniPaused = false
                    miniPlay.Text = "Ⅱ"
                    startMiniEQ()
                    setRadioStatus("PLAYING  •  " .. tostring(title or radioId), true)
                else
                    miniPaused = true
                    miniPlay.Text = "▶"
                    stopMiniEQ()
                    setRadioStatus("CAN'T LOAD  •  asset private, removed or unavailable here", false)
                end
            end)
            sound.Ended:Connect(function()
                if __SW_RadioSound == sound then
                    miniPaused = true
                    miniPlay.Text = "▶"
                    stopMiniEQ()
                    setRadioStatus("FINISHED  •  " .. tostring(title or radioId), false)
                end
            end)
        end)
