function __SW_UpdateESP()
    if not ESP.Enabled then
        if next(ESP.Objects) then
            for _, obj in pairs(ESP.Objects) do
                __SW_HideAllESP(obj)
                __SW_ClearChams(obj)
            end
        end
        return
    end
    Camera = workspace.CurrentCamera
    if not Camera then return end
    local viewportSize = Camera.ViewportSize
    local center2 = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local players = Players:GetPlayers()
    for i = 1, #players do
        local plr = players[i]
        if plr ~= LocalPlayer then

            pcall(function()
                local char = plr.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local head = char and char:FindFirstChild("Head")
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                local isAlive = humanoid and humanoid.Health > 0
                local characterInWorld = char and char:IsDescendantOf(workspace)
                -- Never keep drawings attached to a dead character or a character removed at round end.
                if char and characterInWorld and hrp and head and isAlive then
                    if not ESP.Objects[plr] then __SW_CreateESPForPlayer(plr) end
                    local obj = ESP.Objects[plr]
                    if obj then
                        if obj._character ~= char then
                            __SW_ClearChams(obj)
                            obj._chamsApplied = false
                            obj._chamsRole = nil
                            obj._chamsSignature = nil
                            obj._character = char
                        end
                        local role = __SW_DetectRole(plr)
                        local distance = myRoot and (myRoot.Position - hrp.Position).Magnitude or 0
                        local teamOk = true
                        if ESP.TeamCheck and plr.Team and LocalPlayer.Team then
                            teamOk = (plr.Team ~= LocalPlayer.Team)
                        end
                        local roleColors = ESP.Colors[role] or ESP.Colors.Unknown
                        local boxColor = ESP.UseRoleColors and roleColors.Box or ESP.Colors.Unknown.Box
                        local nameColor = ESP.UseRoleColors and roleColors.Name or ESP.Colors.Unknown.Name
                        local tracerColor = ESP.UseRoleColors and roleColors.Tracer or ESP.Colors.Unknown.Tracer
                        -- Rebuild chams whenever any relevant setting changes. Previously this
                        -- only checked the role, so changing the dropdown often left old/no chams.
                        local chamsSignature = table.concat({
                            tostring(ESP.ChamsType),
                            tostring(ESP.ChamsTransparency),
                            tostring(ESP.UseRoleColors),
                            tostring(role),
                            tostring(ESP.Colors[role] and ESP.Colors[role].Chams),
                            tostring(char),
                        }, "|")
                        if ESP.Chams and teamOk then
                            if not obj._chamsApplied or obj._chamsSignature ~= chamsSignature then
                                __SW_ClearChams(obj)
                                __SW_ApplyChams(plr, char)
                                obj._chamsApplied = true
                                obj._chamsRole = role
                                obj._chamsSignature = chamsSignature
                            end
                        else
                            if obj._chamsApplied then
                                __SW_ClearChams(obj)
                                obj._chamsApplied = false
                                obj._chamsRole = nil
                                obj._chamsSignature = nil
                            end
                        end
                        if distance <= ESP.MaxDistance and teamOk then
                            local headPos, headOn = __SW_WorldToScreen(head.Position + Vector3.new(0, 0.6, 0))
                            local rootPos, rootOn = __SW_WorldToScreen(hrp.Position - Vector3.new(0, 3, 0))
                            if headOn and rootOn then
                                local height = math.abs(rootPos.Y - headPos.Y)
                                local width = height / 2
                                local topLeft = Vector2.new(headPos.X - width / 2, headPos.Y)
                                local topRight = Vector2.new(headPos.X + width / 2, headPos.Y)
                                local bottomLeft = Vector2.new(headPos.X - width / 2, rootPos.Y)
                                local bottomRight = Vector2.new(headPos.X + width / 2, rootPos.Y)
                                if ESP.Boxes then
                                    if ESP.BoxType == "3D Box" then
                                        local cf = char:GetPivot()
                                        local size = Vector3.new(2, 5.5, 1)
                                        local signs = {
                                            Vector3.new(-1,-1,-1), Vector3.new(1,-1,-1),
                                            Vector3.new(1,1,-1), Vector3.new(-1,1,-1),
                                            Vector3.new(-1,-1,1), Vector3.new(1,-1,1),
                                            Vector3.new(1,1,1), Vector3.new(-1,1,1),
                                        }
                                        local corners = {}
                                        for ci, s in ipairs(signs) do
                                            local world = (cf * CFrame.new(s.X * size.X/2, s.Y * size.Y/2, s.Z * size.Z/2)).Position
                                            local sp, on = __SW_WorldToScreen(world)
                                            corners[ci] = {pos = sp, on = on}
                                        end
                                        local edges = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
                                        for ei, e in ipairs(edges) do
                                            local a, b = corners[e[1]], corners[e[2]]
                                            local line = obj.Box3D[ei]
                                            if line and a.on and b.on then
                                                line.From = a.pos; line.To = b.pos
                                                line.Color = boxColor; line.Thickness = ESP.BoxThickness
                                                line.Visible = true
                                            elseif line and line.Visible then line.Visible = false end
                                        end
                                    elseif ESP.BoxType == "2D Corner" then
                                        if obj.Box and obj.Box.Visible then obj.Box.Visible = false end
                                        local L = obj.CornerLines
                                        local w = topRight.X - topLeft.X
                                        local h = bottomLeft.Y - topLeft.Y
                                        local seg = math.min(w, h) * 0.25
                                        if L then
                                            L[1].From = topLeft; L[1].To = Vector2.new(topLeft.X + seg, topLeft.Y)
                                            L[2].From = topLeft; L[2].To = Vector2.new(topLeft.X, topLeft.Y + seg)
                                            L[3].From = topRight; L[3].To = Vector2.new(topRight.X - seg, topRight.Y)
                                            L[4].From = topRight; L[4].To = Vector2.new(topRight.X, topRight.Y + seg)
                                            L[5].From = bottomLeft; L[5].To = Vector2.new(bottomLeft.X + seg, bottomLeft.Y)
                                            L[6].From = bottomLeft; L[6].To = Vector2.new(bottomLeft.X, bottomLeft.Y - seg)
                                            L[7].From = bottomRight; L[7].To = Vector2.new(bottomRight.X - seg, bottomRight.Y)
                                            L[8].From = bottomRight; L[8].To = Vector2.new(bottomRight.X, bottomRight.Y - seg)
                                            for _, l in ipairs(L) do
                                                if l then l.Color = boxColor; l.Thickness = ESP.BoxThickness; l.Visible = true end
                                            end
                                        end
                                    else
                                        if obj.CornerLines then
                                            for i2 = 1, #obj.CornerLines do
                                                local l = obj.CornerLines[i2]
                                                if l and l.Visible then l.Visible = false end
                                            end
                                        end
                                        if obj.Box then
                                            obj.Box.Size = Vector2.new(topRight.X - topLeft.X, bottomLeft.Y - topLeft.Y)
                                            obj.Box.Position = topLeft
                                            obj.Box.Color = boxColor
                                            obj.Box.Thickness = ESP.BoxThickness
                                            obj.Box.Visible = true
                                        end
                                    end
                                else
                                    if obj.Box and obj.Box.Visible then obj.Box.Visible = false end
                                    if obj.CornerLines then
                                        for i2 = 1, #obj.CornerLines do
                                            local l = obj.CornerLines[i2]
                                            if l and l.Visible then l.Visible = false end
                                        end
                                    end
                                    if obj.Box3D then
                                        for i2 = 1, #obj.Box3D do
                                            local l = obj.Box3D[i2]
                                            if l and l.Visible then l.Visible = false end
                                        end
                                    end
                                end
                                if ESP.Names and obj.NameTag and S.hasDrawing then
                                    obj.NameTag.Position = Vector2.new(headPos.X, headPos.Y - 16)
                                    obj.NameTag.Text = plr.Name
                                    obj.NameTag.Color = nameColor
                                    obj.NameTag.Size = ESP.NameSize
                                    obj.NameTag.Visible = true
                                elseif obj.NameTag and obj.NameTag.Visible then
                                    obj.NameTag.Visible = false
                                end
                                if ESP.ShowRole and obj.RoleTag and S.hasDrawing then
                                    obj.RoleTag.Position = Vector2.new(headPos.X, headPos.Y - 30)
                                    obj.RoleTag.Text = role:upper()
                                    obj.RoleTag.Color = __SW_GetRoleColor(role)
                                    obj.RoleTag.Visible = true
                                elseif obj.RoleTag and obj.RoleTag.Visible then
                                    obj.RoleTag.Visible = false
                                end
                                if ESP.Distance and obj.DistanceTag and S.hasDrawing then
                                    obj.DistanceTag.Position = Vector2.new(headPos.X, rootPos.Y + 4)
                                    obj.DistanceTag.Text = string.format("[%d m]", math.floor(distance))
                                    obj.DistanceTag.Color = ESP.DistanceColor
                                    obj.DistanceTag.Visible = true
                                elseif obj.DistanceTag and obj.DistanceTag.Visible then
                                    obj.DistanceTag.Visible = false
                                end
                                if ESP.Health and S.hasDrawing and obj.HealthBar then
                                    local hpct = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
                                    local barH = height * hpct
                                    obj.HealthBarBg.Size = Vector2.new(3, height)
                                    obj.HealthBarBg.Position = Vector2.new(topLeft.X - 7, topLeft.Y)
                                    obj.HealthBarBg.Visible = true
                                    obj.HealthBar.Size = Vector2.new(3, barH)
                                    obj.HealthBar.Position = Vector2.new(topLeft.X - 7, topLeft.Y + (height - barH))
                                    obj.HealthBar.Color = ESP.HealthColor
                                    obj.HealthBar.Visible = true
                                    if ESP.HealthText and obj.HealthText then
                                        obj.HealthText.Position = Vector2.new(topLeft.X - 20, topLeft.Y + height/2 - 6)
                                        obj.HealthText.Text = tostring(math.floor(humanoid.Health))
                                        obj.HealthText.Color = ESP.HealthColor
                                        obj.HealthText.Visible = true
                                    elseif obj.HealthText and obj.HealthText.Visible then
                                        obj.HealthText.Visible = false
                                    end
                                elseif S.hasDrawing then
                                    if obj.HealthBar and obj.HealthBar.Visible then obj.HealthBar.Visible = false end
                                    if obj.HealthBarBg and obj.HealthBarBg.Visible then obj.HealthBarBg.Visible = false end
                                    if obj.HealthText and obj.HealthText.Visible then obj.HealthText.Visible = false end
                                end
                                if ESP.Tracers and obj.Tracer and S.hasDrawing then
                                    local origin
                                    if ESP.TracerOrigin == "Top" then origin = Vector2.new(viewportSize.X / 2, 0)
                                    elseif ESP.TracerOrigin == "Center" then origin = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
                                    else origin = Vector2.new(viewportSize.X / 2, viewportSize.Y) end
                                    obj.Tracer.From = origin
                                    obj.Tracer.To = Vector2.new(rootPos.X, rootPos.Y)
                                    obj.Tracer.Color = tracerColor
                                    obj.Tracer.Visible = true
                                elseif obj.Tracer and obj.Tracer.Visible then
                                    obj.Tracer.Visible = false
                                end

                                if ESP.Arrows and obj.Arrow and S.hasDrawing then
                                    local cam2 = Camera
                                    local dir = (head.Position - cam2.CFrame.Position)
                                    local right = cam2.CFrame.RightVector
                                    local forward = cam2.CFrame.LookVector
                                    local flat = Vector3.new(dir.X, 0, dir.Z)
                                    if flat.Magnitude > 0.01 then flat = flat.Unit end
                                    local rightDot = flat:Dot(Vector3.new(right.X, 0, right.Z).Unit)
                                    local fwdDot = flat:Dot(Vector3.new(forward.X, 0, forward.Z).Unit)
                                    local angle = math.atan2(rightDot, fwdDot)
                                    local radius = ESP.ArrowRadius
                                    local size = ESP.ArrowSize
                                    local cx = center2.X + math.sin(angle) * radius
                                    local cy = center2.Y - math.cos(angle) * radius
                                    local tipX = cx + math.sin(angle) * size
                                    local tipY = cy - math.cos(angle) * size
                                    local leftX = cx + math.sin(angle + 2.4) * size * 0.7
                                    local leftY = cy - math.cos(angle + 2.4) * size * 0.7
                                    local rightX = cx + math.sin(angle - 2.4) * size * 0.7
                                    local rightY = cy - math.cos(angle - 2.4) * size * 0.7
                                    obj.Arrow.PointA = Vector2.new(tipX, tipY)
                                    obj.Arrow.PointB = Vector2.new(leftX, leftY)
                                    obj.Arrow.PointC = Vector2.new(rightX, rightY)
                                    obj.Arrow.Color = ESP.ArrowColor
                                    obj.Arrow.Filled = true
                                    obj.Arrow.Visible = true
                                elseif obj.Arrow and obj.Arrow.Visible then
                                    obj.Arrow.Visible = false
                                end
                                if ESP.Skeleton then
                                    for bi, bone in ipairs(SKELETON_BONES) do
                                        local a = char:FindFirstChild(bone[1])
                                        local b = char:FindFirstChild(bone[2])
                                        local line = obj.SkeletonLines[bi]
                                        if a and b and line then
                                            local ap, aOn = __SW_WorldToScreen(a.Position)
                                            local bp, bOn = __SW_WorldToScreen(b.Position)
                                            if aOn and bOn then
                                                line.From = ap; line.To = bp
                                                line.Color = ESP.SkeletonColor
                                                line.Thickness = ESP.SkeletonThickness
                                                line.Visible = true
                                            elseif line.Visible then line.Visible = false end
                                        elseif line and line.Visible then line.Visible = false end
                                    end
                                elseif obj.SkeletonLines then
                                    for i2 = 1, #obj.SkeletonLines do
                                        local l = obj.SkeletonLines[i2]
                                        if l and l.Visible then l.Visible = false end
                                    end
                                end
                            else
                                __SW_HideAllESP(obj)
                            end
                        else
                            __SW_HideAllESP(obj)
                        end
                    end
                else
                    if ESP.Objects[plr] then
                        __SW_ClearChams(ESP.Objects[plr])
                        __SW_RemoveESPForPlayer(plr)
                    end
                end
            end)
        end
    end
    for plr in pairs(ESP.Objects) do
        if not plr.Parent then __SW_RemoveESPForPlayer(plr) end
    end
end

