ConfigMgr.Folder = ConfigMgr.RootFolder .. "/Configs"
ConfigMgr.Extension = ".json"
ConfigMgr.Version = 4

function __SW_ensureFolder()
    if not (writefile and makefolder) then return false end
    local ok = true
    if not (isfolder and isfolder(ConfigMgr.RootFolder)) then
        ok = pcall(function() makefolder(ConfigMgr.RootFolder) end) and ok
    end
    if not (isfolder and isfolder(ConfigMgr.Folder)) then
        ok = pcall(function() makefolder(ConfigMgr.Folder) end) and ok
    end
    -- Migrate legacy configs once into the new folder.
    if ok and listfiles and readfile and isfile and writefile and isfolder and isfolder("sw1nium_configs") then
        pcall(function()
            local legacy = listfiles("sw1nium_configs")
            for _, f in ipairs(legacy) do
                local fileName = f:match("([^/\\]+)$") or f
                if fileName:sub(-#ConfigMgr.Extension) == ConfigMgr.Extension then
                    local dst = ConfigMgr.Folder .. "/" .. fileName
                    if not isfile(dst) then writefile(dst, readfile(f)) end
                end
            end
        end)
    end
    return ok
end

function __SW_sanitizeConfigName(name)
    name = tostring(name or "default")
    name = name:gsub("[<>:\"/\\|%?%*]", "_"):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then name = "default" end
    return name:sub(1, 48)
end

function ConfigMgr.List()
    local out = {}
    __SW_ensureFolder()
    if not (listfiles and isfolder and isfolder(ConfigMgr.Folder)) then return out end
    local ok, files = pcall(function() return listfiles(ConfigMgr.Folder) end)
    if not ok or type(files) ~= "table" then return out end
    for _, f in ipairs(files) do
        local fileName = f:match("([^/\\]+)$") or f
        if fileName:sub(-#ConfigMgr.Extension) == ConfigMgr.Extension then
            table.insert(out, fileName:sub(1, #fileName - #ConfigMgr.Extension))
        end
    end
    table.sort(out, function(a,b) return a:lower() < b:lower() end)
    return out
end

function ConfigMgr.Path(name)
    return ConfigMgr.Folder .. "/" .. __SW_sanitizeConfigName(name) .. ConfigMgr.Extension
end

