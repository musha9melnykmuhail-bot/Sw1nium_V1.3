S.WorldUtil.setSky = function(name)
    S.WorldUtil.removeSky()
    S.WorldState.skyPreset = name
    local sky = Instance.new("Sky")
    sky.Name = "Sw1nium_Sky"
    local data = S.WorldUtil.skyPresets[name]
    if data then for k, v in pairs(data) do pcall(function() sky[k] = v end) end end
    sky.Parent = Lighting
    S.WorldState.sky = sky
end
S.WorldUtil.stopWeather = function()
    for _, c in ipairs(S.WorldState.weatherConns) do pcall(function() c:Disconnect() end) end
    S.WorldState.weatherConns = {}
    for _, inst in ipairs(S.WorldState.effects) do pcall(function() inst:Destroy() end) end
    S.WorldState.effects = {}
end
S.WorldUtil.startEmitter = function(name, props)
    S.WorldUtil.stopWeather()
    local em = Instance.new("ParticleEmitter")
    em.Name = name
    for k, v in pairs(props) do pcall(function() em[k] = v end) end
    em.Parent = workspace.Terrain
    table.insert(S.WorldState.effects, em)
end

