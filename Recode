        __SW_AutoFarmEnabled = enabled
        if enabled then
            __SW_ShowNotification("Coin Auto Farm enabled", true)
            task.spawn(function()
                while __SW_AutoFarmEnabled do
                    local character = LocalPlayer and LocalPlayer.Character
                    local root = character and character:FindFirstChild("HumanoidRootPart")
                    local container = workspace:FindFirstChild("CoinContainer", true)
                    local candidates = {}
                    if container then
                        for _, obj in ipairs(container:GetDescendants()) do
                            if obj:IsA("BasePart") and (obj.Name == "Coin_Server" or obj.Name == "Coin" or obj.Name == "Coin_ServerPart") then
                                candidates[#candidates + 1] = obj
                            end
                        end
                        if container:IsA("BasePart") and (container.Name == "Coin_Server" or container.Name == "Coin") then
                            candidates[#candidates + 1] = container
                        end
                    end
                    if root and #candidates > 0 then
                        table.sort(candidates, function(a, b)
                            if not a.Parent then return false end
                            if not b.Parent then return true end
                            return (a.Position - root.Position).Magnitude < (b.Position - root.Position).Magnitude
                        end)
                        local target = candidates[1]
                        if target and target.Parent then
                            local touched = false
                            if typeof(firetouchinterest) == "function" then
                                touched = pcall(function()
                                    firetouchinterest(root, target, 0)
                                    task.wait(0.05)
                                    firetouchinterest(root, target, 1)
                                end)
                            end
                            if not touched then
