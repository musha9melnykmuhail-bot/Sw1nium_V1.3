function __SW_ResolveMenuImage(source)
    source = tostring(source or "")
    if source == "" then return "" end
    if makefolder and isfolder and not isfolder("Sw1nium") then pcall(function() makefolder("Sw1nium") end) end
    if source:match("^rbxassetid://") or source:match("^rbxthumb://") then return source end
    if source:match("^https?://") and getcustomasset and writefile and isfile then
        local ext = source:match("%.([%w]+)[^/]*$") or "png"
        local fileName = "Sw1nium/menu_background." .. ext
        local ok = pcall(function()
            if not isfile(fileName) then writefile(fileName, game:HttpGet(source)) end
        end)
        if ok and isfile(fileName) then
            local assetOk, asset = pcall(function() return getcustomasset(fileName) end)
            if assetOk then return asset end
        end
    end
    if isfile and getcustomasset then
        local ok, asset = pcall(function() return isfile(source) and getcustomasset(source) or nil end)
        if ok and asset then return asset end
    end
    return source
end

