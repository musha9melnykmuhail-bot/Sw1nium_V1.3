    Instance.new("UICorner", toggleBg).CornerRadius = UDim.new(1, 0)

    local tStroke = Instance.new("UIStroke", toggleBg)
    tStroke.Color = defaultState and C_TOGGLE_ON or C_BORDER
    tStroke.Thickness = 1

    local thumb = Instance.new("Frame", toggleBg)
    thumb.Size = UDim2.new(0, 14, 0, 14)
    thumb.Position = defaultState and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    thumb.BackgroundColor3 = defaultState and Color3.fromRGB(255, 255, 255) or C_MUTED
    thumb.BorderSizePixel = 0
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)

    local label = Instance.new("TextLabel", mainBtn)
    label.Size = UDim2.new(1, -112, 1, 0)
    label.Position = UDim2.new(0, 42, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.BuilderSansMedium
    label.Text = text
    label.TextColor3 = defaultState and C_ACCENT or C_MUTED
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left

    -- Left click: bind key. Right click: cycle Toggle -> Hold -> Always On.
    -- Middle click: clear the bind.
    local bindBtn = Instance.new("ImageButton", wrap)
    bindBtn.Name = "KeybindAsset"
    bindBtn.Size = UDim2.new(0, 28, 0, 28)
    bindBtn.Position = UDim2.new(1, -34, 0.5, -14)
    bindBtn.BackgroundColor3 = C_BG
    bindBtn.AutoButtonColor = false
    bindBtn.Image = "rbxassetid://73078858893187"
    bindBtn.ImageColor3 = C_MUTED
    bindBtn.ScaleType = Enum.ScaleType.Fit
    bindBtn.ZIndex = 4
    Instance.new("UICorner", bindBtn).CornerRadius = UDim.new(0, 6)
    local bSt2 = Instance.new("UIStroke", bindBtn)
    bSt2.Color = C_BORDER
    bSt2.Thickness = 1

    local state = defaultState
    local locked = false
    local binding = nil
    local bindMode = "Toggle"

    local kbRow = Instance.new("Frame", kbListFrame)
    kbRow.Size = UDim2.new(1, 0, 0, 16)
    kbRow.BackgroundTransparency = 1
    kbRow.Visible = false

    local kbTextLabel = Instance.new("TextLabel", kbRow)
    kbTextLabel.Size = UDim2.new(0.7, 0, 1, 0)
    kbTextLabel.Position = UDim2.new(0, 8, 0, 0)
    kbTextLabel.BackgroundTransparency = 1
    kbTextLabel.Font = Enum.Font.BuilderSansMedium
    kbTextLabel.Text = text
    kbTextLabel.TextColor3 = C_MUTED
    kbTextLabel.TextSize = 10
    kbTextLabel.TextXAlignment = Enum.TextXAlignment.Left

    local kbStatusLabel = Instance.new("TextLabel", kbRow)
    kbStatusLabel.Size = UDim2.new(0.3, -8, 1, 0)
    kbStatusLabel.Position = UDim2.new(0.7, 0, 0, 0)
    kbStatusLabel.BackgroundTransparency = 1
    kbStatusLabel.Font = Enum.Font.BuilderSansBold
    kbStatusLabel.Text = "[NONE]"
    kbStatusLabel.TextColor3 = C_ACCENT
    kbStatusLabel.TextSize = 9
    kbStatusLabel.TextXAlignment = Enum.TextXAlignment.Right

    local item = {Frame = kbRow, KeyLabel = kbStatusLabel}
    table.insert(ActiveBinds, item)

    local function bindingName(b)
        if not b then return "NONE" end
        local parts = {}
        if b.Ctrl then table.insert(parts, "CTRL") end
        if b.Shift then table.insert(parts, "SHIFT") end
        if b.Alt then table.insert(parts, "ALT") end
        local keyLabel = b.Name or "KEY"
        if keyLabel == "MouseButton1" then keyLabel = "M1"
        elseif keyLabel == "MouseButton2" then keyLabel = "M2"
        elseif keyLabel == "MouseButton3" then keyLabel = "M3" end
        table.insert(parts, keyLabel)
        return table.concat(parts, " + ")
    end

    local function matchesInput(input, b)
        if not b then return false end
        local name
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl
                or input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift
                or input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
                return false
            end
            name = input.KeyCode.Name
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            name = "MouseButton1"
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            name = "MouseButton2"
        elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
            name = "MouseButton3"
        else
            return false
        end
        if name ~= b.Name then return false end
        local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
        local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
        local alt = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt)
        return ctrl == b.Ctrl and shift == b.Shift and alt == b.Alt
    end

    local function modeName()
        if bindMode == "Hold" then return "HOLD" end
        if bindMode == "Always" then return "ALWAYS ON" end
        return "TOGGLE"
    end

    local function updateVisuals()
        local tw = TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        if locked then
            TweenService:Create(toggleBg, tw, {BackgroundColor3 = C_LOCK_BG}):Play()
            TweenService:Create(tStroke, tw, {Color = C_LOCK_STROKE}):Play()
            TweenService:Create(thumb, tw, {BackgroundColor3 = Color3.fromRGB(120, 110, 60)}):Play()
            TweenService:Create(label, tw, {TextColor3 = C_LOCK_YELLOW}):Play()
            TweenService:Create(bindBtn, tw, {ImageColor3 = C_LOCK_YELLOW}):Play()
            kbRow.Visible = false
        else
            TweenService:Create(toggleBg, tw, {BackgroundColor3 = state and C_TOGGLE_ON or C_TOGGLE_OFF}):Play()
            TweenService:Create(tStroke, tw, {Color = state and C_TOGGLE_ON or C_BORDER}):Play()
            TweenService:Create(thumb, tw, {
                Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
                BackgroundColor3 = state and Color3.fromRGB(255, 255, 255) or C_MUTED,
            }):Play()
            TweenService:Create(label, tw, {TextColor3 = state and C_TOGGLE_ON or C_MUTED}):Play()
            TweenService:Create(bindBtn, tw, {ImageColor3 = binding and C_ACCENT or C_MUTED}):Play()
            kbRow.Visible = (state and binding ~= nil and bindMode ~= "Always")
            kbStatusLabel.Text = binding and ("[" .. bindingName(binding) .. "] " .. modeName()) or "[NONE]"
        end
        __SW_UpdateKeybindContainerHeight()
    end

    local function update(newState, silent)
        if locked then return end
        state = newState == true
        updateVisuals()
        if not silent then __SW_ShowNotification(text, state) end
        if callback then callback(state) end
    end

    local function cycleMode()
        if bindMode == "Toggle" then
            bindMode = "Hold"
        elseif bindMode == "Hold" then
            bindMode = "Always"
            state = true
        else
            bindMode = "Toggle"
        end
        if bindMode == "Always" then
            state = true
            if callback then callback(true) end
        end
        updateVisuals()
        __SW_ShowNotification(text .. " mode: " .. modeName(), "Info")
    end

    mainBtn.MouseButton1Click:Connect(function()
        if bindMode == "Always" then return end
        update(not state)
    end)

    bindBtn.MouseButton1Click:Connect(function()
        if locked then return end
        if OpenKeybindPanel then
            OpenKeybindPanel(text)
        end
    end)

    item.Trigger = function(input)
        if locked or not binding or not matchesInput(input, binding) then return end
        if bindMode == "Toggle" then
            update(not state)
        elseif bindMode == "Hold" then
            update(true)
        end
    end
    item.Release = function(input)
        if locked or not binding or bindMode ~= "Hold" then return end
        if matchesInput(input, binding) then update(false) end
    end
    item.GetBinding = function() return binding end
    item.Destroy = function()
        if BindingCapture and BindingCapture.Item == item then BindingCapture = nil end
        if kbRow then kbRow:Destroy() end
    end

    table.insert(S.RegisteredToggles, function()
        if state then update(false, true) end
    end)

    local wrapper = {
        Set = function(v, silent) update(v, silent) end,
        Get = function() return state end,
        GetKeybind = function() return binding end,
        SetKeybind = function(b)
            binding = b
            updateVisuals()
        end,
        CaptureKeybind = function(button)
            if locked then return end
            if BindingCapture and BindingCapture.CaptureButton then
                pcall(function() BindingCapture.CaptureButton.ImageColor3 = C_MUTED end)
            end
            BindingCapture = {
                Item = item,
                SetBinding = function(b)
                    binding = b
                    updateVisuals()
                    BindingCapture = nil
                end,
                CaptureButton = button,
            }
            if button then button.Text = "PRESS KEY" end
        end,
        ClearKeybind = function()
            binding = nil
            updateVisuals()
        end,
        GetKeybindMode = function() return bindMode end,
        SetKeybindMode = function(mode)
            if mode == "Hold" or mode == "Always" or mode == "Toggle" then
                bindMode = mode
                if mode == "Always" then state = true end
                updateVisuals()
            end
        end,
        ForceOff = function()
            if state then
                state = false
                updateVisuals()
                if callback then callback(false) end
            end
        end,
        SetLocked = function(v)
            locked = v == true
            if locked and state then
                state = false
                if callback then callback(false) end
            end
            updateVisuals()
        end,
        Group = group,
        Name = text,
    }
    table.insert(S.KeybindWrappers, wrapper)
    if group then table.insert(S.SafeModeToggles, wrapper) end
    return wrapper
end

function W.CreateSlider(parent, labelText, minVal, maxVal, defaultVal, suffix, callback)
    local wrap = Instance.new("Frame", parent)
    wrap.Size = UDim2.new(1, 0, 0, 36)
    wrap.BackgroundTransparency = 1
    local title = Instance.new("TextLabel", wrap)
    title.Size = UDim2.new(0.65, 0, 0, 14)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.BuilderSansMedium
    title.Text = labelText
    title.TextColor3 = C_MUTED
    title.TextSize = 12
    title.TextXAlignment = Enum.TextXAlignment.Left

    local valueBox = Instance.new("TextBox", wrap)
    valueBox.Size = UDim2.new(0.35, 0, 0, 14)
    valueBox.Position = UDim2.new(0.65, 0, 0, 0)
    valueBox.BackgroundTransparency = 1
    valueBox.Font = Enum.Font.BuilderSansBold
    valueBox.Text = string.format("%.2f", defaultVal) .. (suffix or "")
    valueBox.TextColor3 = C_HEADER_TEXT
    valueBox.TextSize = 11
    valueBox.TextXAlignment = Enum.TextXAlignment.Right
    valueBox.ClearTextOnFocus = false

    local bar = Instance.new("TextButton", wrap)
    bar.Size = UDim2.new(1, 0, 0, 8)
    bar.Position = UDim2.new(0, 0, 0, 18)
    bar.BackgroundColor3 = C_BAR_BG
    bar.Text = ""
    bar.AutoButtonColor = false
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 4)

    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new(math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1), 0, 1, 0)
    fill.BackgroundColor3 = C_BAR_FILL
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 4)

    local sliding = false
    local currentValue = defaultVal

    local function applyValue(v, fireCallback)
        local numericValue = tonumber(v)
        if not numericValue and type(v) == "string" then
            numericValue = tonumber(v:match("[-+]?%d*%.?%d+"))
        end
        numericValue = numericValue or currentValue
        v = math.clamp(numericValue, minVal, maxVal)
        currentValue = v
        local pct = (v - minVal) / (maxVal - minVal)
        TweenService:Create(fill, TweenInfo.new(0.1), {Size = UDim2.new(pct, 0, 1, 0)}):Play()
        valueBox.Text = string.format("%.2f", v) .. (suffix or "")
        if fireCallback ~= false and callback then callback(v) end
    end

    local function updateFromX(x)
        local pct = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        applyValue(minVal + (maxVal - minVal) * pct, true)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            S.isInteracting = true
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = false
            S.isInteracting = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromX(input.Position.X)
        end
    end)

    valueBox.FocusLost:Connect(function()
        applyValue(valueBox.Text, true)
    end)

    return function(v, silent) applyValue(v, silent ~= true) end
end

