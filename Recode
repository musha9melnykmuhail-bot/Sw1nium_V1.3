    local followerStatus = nil
    local followerCard = makeSkinsCard("FRIEND FOLLOWER", "A local-only dummy follows about 5 studs behind you. It has no collisions and is not visible to other players.")
    local function setFollowerStatus(message, good)
        if followerStatus and followerStatus.Parent then
            followerStatus.Text = message
            followerStatus.TextColor3 = good and Color3.fromRGB(100, 220, 155) or C_MUTED
        end
