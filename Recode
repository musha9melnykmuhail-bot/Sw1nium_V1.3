                if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
            end)
            if not current:FindFirstChild("Torium_GodMode") then Troll.ApplyGodModeToCharacter(current) end
        end
    end)
    CM.godModeCharacterConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
        task.wait(0.35)
