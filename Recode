function __SW_CM_GetMyRole() return __SW_DetectRole(LocalPlayer) end

function __SW_CM_GetTool(name)
    local char = LocalPlayer.Character
    if char then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and t.Name == name then return t end
        end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and t.Name == name then return t end
        end
    end
    return nil
end

function __SW_CM_Equip(tool)
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum and tool then pcall(function() hum:EquipTool(tool) end) end
end

function __SW_CM_Hitbox(plr)
    local char = plr.Character
    if not char then return nil end
    local name = CM.hitbox
    if name == "Random" then
        local opts = {"Head", "UpperTorso", "HumanoidRootPart"}
        name = opts[math.random(1, #opts)]
    end
    return char:FindFirstChild(name) or char:FindFirstChild("HumanoidRootPart")
end

function __SW_CM_Visible(target)
    if not CM.visibleOnly then return true end
    local cam = workspace.CurrentCamera
    local myChar = LocalPlayer.Character
    if not cam or not myChar then return false end
    local part = __SW_CM_Hitbox(target)
    if not part then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myChar, target.Character, cam}
    local result = workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, params)
    return result == nil
end

function __SW_CM_NearestInFov(filter)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local closest, closestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local role = __SW_DetectRole(plr)
                local match = false
                if filter == "enemy" then match = (role ~= "Murderer" and role ~= "Unknown")
                elseif filter == "murderer" then match = (role == "Murderer")
                elseif filter == "any" then match = true end
                if match then
                    local d = (hrp.Position - myRoot.Position).Magnitude
                    if d <= CM.maxDistance then
                        local sp, on = cam:WorldToViewportPoint(hrp.Position)
                        if on then
                            local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
                            local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if sd <= CM.fovRadius and sd < closestDist then
                                if __SW_CM_Visible(plr) then closest, closestDist = plr, sd end
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

function __SW_CM_NearestByDist(filter, maxD)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local closest, closestDist = nil, maxD or math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local role = __SW_DetectRole(plr)
                local match = false
                if filter == "enemy" then match = (role ~= "Murderer" and role ~= "Unknown")
                elseif filter == "murderer" then match = (role == "Murderer")
                elseif filter == "any" then match = true end
                if match then
                    local d = (hrp.Position - myRoot.Position).Magnitude
                    if d <= closestDist then closest, closestDist = plr, d end
                end
            end
        end
    end
    return closest
end

function __SW_CM_StopKillAll()
    if CM.killAllConn then CM.killAllConn:Disconnect(); CM.killAllConn = nil end
end

function __SW_CM_StartKillAll()
    __SW_CM_StopKillAll()
    CM.killAllConn = RunService.Heartbeat:Connect(function()
        if not CM.killAll or __SW_CM_GetMyRole() ~= "Murderer" then return end
        local now = tick()
        if now - CM._lastKill < CM.killAllDelay then return end

        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local knife = __SW_CM_GetTool("Knife")
        if not root or not knife then return end
        __SW_CM_Equip(knife)

        local handle = knife:FindFirstChild("Handle")
        if not handle or not handle:IsA("BasePart") then return end

        local targets = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local role = __SW_DetectRole(plr)
                local targetChar = plr.Character
                local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                local hum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
                if role ~= "Murderer" and role ~= "Unknown" and targetRoot and hum and hum.Health > 0 then
                    local distance = (targetRoot.Position - root.Position).Magnitude
                    if distance <= CM.killAllRange then
                        targets[#targets + 1] = {player = plr, root = targetRoot, distance = distance}
                    end
                end
            end
        end

        table.sort(targets, function(a, b) return a.distance < b.distance end)
        for _, target in ipairs(targets) do
            pcall(function() knife:Activate() end)
            if firetouchinterest then
                pcall(function()
                    firetouchinterest(handle, target.root, 0)
                    firetouchinterest(handle, target.root, 1)
                end)
            end
        end
        if #targets > 0 then CM._lastKill = now end
    end)
end

function __SW_CM_StopAutoShoot() if CM.autoShootConn then CM.autoShootConn:Disconnect(); CM.autoShootConn = nil end end
function __SW_CM_StartAutoShoot()
    __SW_CM_StopAutoShoot()
    CM.autoShootConn = RunService.Heartbeat:Connect(function()
        if not CM.autoShoot then return end
        if __SW_CM_GetMyRole() ~= "Sheriff" then return end
        local now = tick()
        if now - CM._lastShot < CM.autoShootDelay then return end
        local gun = __SW_CM_GetTool("Gun") or __SW_CM_GetTool("Revolver")
        if not gun then return end
        __SW_CM_Equip(gun)
        local target = __SW_CM_NearestInFov("murderer")
        if target then
            CM._lastShot = now
            local part = __SW_CM_Hitbox(target)
            pcall(function() gun:Activate() end)
            pcall(function()
                if gun:FindFirstChild("Fire") and gun.Fire:IsA("RemoteEvent") then
                    gun.Fire:FireServer(part)
                elseif gun:FindFirstChild("Shoot") and gun.Shoot:IsA("RemoteEvent") then
                    gun.Shoot:FireServer(part.Position, part)
                end
            end)
        end
    end)
end

