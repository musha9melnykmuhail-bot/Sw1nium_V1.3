W._SectionOrder = W._SectionOrder or 0
function W.CreateSection(parent, titleText, iconId)
    W._SectionOrder = W._SectionOrder + 1
    local wrapper = Instance.new("Frame", parent)
    wrapper.Name = "SectionWrapper"
    wrapper.LayoutOrder = W._SectionOrder
    wrapper.Size = UDim2.new(1, 0, 0, 42)
    wrapper.BackgroundTransparency = 1

    local header = W.CreateHeader(wrapper, titleText or "", iconId)
    header.Size = UDim2.new(1, 0, 0, 26)
    header.Position = UDim2.new(0, 0, 0, 0)
    header.BackgroundTransparency = 1
    header.ZIndex = 4

    local arrow = Instance.new("TextButton", header)
    arrow.Name = "CollapseButton"
    arrow.Size = UDim2.new(0, 24, 0, 24)
    arrow.Position = UDim2.new(1, -24, 0.5, -12)
    arrow.BackgroundTransparency = 1
    arrow.Text = "⌃"
    arrow.TextColor3 = C_MUTED
    arrow.Font = Enum.Font.BuilderSansBold
    arrow.TextSize = 14
    arrow.AutoButtonColor = false
    arrow.ZIndex = 5

    local card = Instance.new("Frame", wrapper)
    card.Name = "SectionCard"
    card.Position = UDim2.new(0, 0, 0, 30)
    card.Size = UDim2.new(1, 0, 0, 12)
    card.BackgroundColor3 = C_CARD
    card.ClipsDescendants = true
    card.BorderSizePixel = 0
    card.ZIndex = 2
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 9)
    local cStroke = Instance.new("UIStroke", card)
    cStroke.Color = C_BORDER
    cStroke.Thickness = 1

    local pad = Instance.new("UIPadding", card)
    pad.PaddingTop = UDim.new(0, 10)
    pad.PaddingBottom = UDim.new(0, 10)
    pad.PaddingLeft = UDim.new(0, 11)
    pad.PaddingRight = UDim.new(0, 11)

    local layout = Instance.new("UIListLayout", card)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 7)

    local collapsed = false
    local animating = false

    local function contentHeight()
        return math.max(12, layout.AbsoluteContentSize.Y + pad.PaddingTop.Offset + pad.PaddingBottom.Offset)
    end

    local function syncSize()
        if not collapsed and not animating then
            local h = contentHeight()
            card.Size = UDim2.new(1, 0, 0, h)
            wrapper.Size = UDim2.new(1, 0, 0, h + 30)
        end
    end

    local function setContentVisible(v)
        for _, child in ipairs(card:GetChildren()) do
            if child:IsA("GuiObject") then
                child.Visible = v
            end
        end
    end

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(syncSize)
    task.defer(syncSize)

    arrow.MouseButton1Click:Connect(function()
        if animating then return end
        collapsed = not collapsed
        animating = true

        if collapsed then
            -- Hide the actual controls first so they cannot leak outside the collapsing card.
            setContentVisible(false)
            local tw = TweenService:Create(card, TweenInfo.new(0.20, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, 0)
            })
            local ww = TweenService:Create(wrapper, TweenInfo.new(0.20, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, 30)
            })
            tw:Play(); ww:Play()
            TweenService:Create(arrow, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Rotation = 180}):Play()
            tw.Completed:Connect(function()
                card.Size = UDim2.new(1, 0, 0, 0)
                wrapper.Size = UDim2.new(1, 0, 0, 30)
                animating = false
            end)
        else
            -- Restore visibility before measuring so the layout gets the real content height.
            card.Size = UDim2.new(1, 0, 0, 0)
            wrapper.Size = UDim2.new(1, 0, 0, 30)
            setContentVisible(true)
            task.defer(function()
                local targetCard = contentHeight()
                local tw = TweenService:Create(card, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    Size = UDim2.new(1, 0, 0, targetCard)
                })
                local ww = TweenService:Create(wrapper, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    Size = UDim2.new(1, 0, 0, targetCard + 30)
                })
                tw:Play(); ww:Play()
                TweenService:Create(arrow, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Rotation = 0}):Play()
                tw.Completed:Connect(function()
                    syncSize()
                    animating = false
                end)
            end)
        end
    end)

    return card
end


