            {0.5,0.355,0.365,0.395}, -- left shoulder
            {0.365,0.395,0.335,0.515}, -- left arm
            {0.5,0.355,0.635,0.395}, -- right shoulder
            {0.635,0.395,0.665,0.515}, -- right arm
            {0.5,0.455,0.415,0.555}, -- torso to left hip
            {0.5,0.455,0.585,0.555}, -- torso to right hip
            {0.415,0.555,0.405,0.715}, -- left leg
            {0.585,0.555,0.595,0.715}, -- right leg
            {0.405,0.715,0.385,0.825}, -- left lower leg
            {0.595,0.715,0.615,0.825}, -- right lower leg
        }
        local skeletonColor = ESP.SkeletonColor or boxColor
        local skeletonThickness = math.clamp(tonumber(ESP.SkeletonThickness) or 1, 1, 5)
        for i, line in ipairs(skeletonLines) do
            local p = skeleton[i]
            line.Visible = ESP.Skeleton and p ~= nil
            if p then setESPLine(line, p[1]*w, p[2]*h, p[3]*w, p[4]*h, skeletonColor, skeletonThickness) end
        end
        skeletonHead.Visible = ESP.Skeleton
        skeletonHeadStroke.Color = skeletonColor
        skeletonHeadStroke.Thickness = skeletonThickness
        skeletonHead.Size = UDim2.new(0, math.clamp(w * 0.045, 9, 15), 0, math.clamp(h * 0.035, 9, 15))
        skeletonHead.Position = UDim2.new(0.5, 0, 0.265, 0)
        arrowIndicator.Visible = ESP.Arrows
        arrowIndicator.TextColor3 = ESP.ArrowColor or boxColor
        arrowIndicator.TextSize = math.clamp(tonumber(ESP.ArrowSize) or 14, 4, 40)
        if previewHighlight then
            previewHighlight.Enabled = ESP.Chams
            previewHighlight.FillColor = chamsColor
            previewHighlight.OutlineColor = chamsColor
            previewHighlight.FillTransparency = math.clamp(tonumber(ESP.ChamsTransparency) or 0.5, 0, 1)
            previewHighlight.OutlineTransparency = ESP.ChamsType == "Fill" and 1 or 0.05
        end
        applyPreviewOffsets()
    end

    -- Right-click drag: hit-testing is handled globally because overlay elements are intentionally non-Active.
    S.ESPPreviewOffsets = S.ESPPreviewOffsets or {}
    local previewOffsets = S.ESPPreviewOffsets
    local previewDragTarget = nil
    local previewDragStart = Vector2.new()
    local previewDragOrigin = Vector2.new()
    local previewDragTargets = {previewBox, previewDepthBox, tracerLine, skeletonHead, nameTag, distanceTag, healthBack, healthNumber, arrowIndicator}
    for _, line in ipairs(depthConnectors) do table.insert(previewDragTargets, line) end
    for _, line in ipairs(skeletonLines) do table.insert(previewDragTargets, line) end
    local appliedOffsets = {}
    for _, target in ipairs(previewDragTargets) do
        if target then
            local key = target.Name
            local saved = previewOffsets[key]
            if type(saved) ~= "table" then previewOffsets[key] = {x = 0, y = 0} end
            target.Active = false
            target.Selectable = false
            target:SetAttribute("PreviewDragEnabled", true)
        end
    end
    applyPreviewOffsets = function()
        for _, target in ipairs(previewDragTargets) do
            if target and target.Parent then
                local key = target.Name
                local previous = appliedOffsets[key] or {x = 0, y = 0}
                local offset = previewOffsets[key] or {x = 0, y = 0}
                target.Position = target.Position - UDim2.fromOffset(previous.x or 0, previous.y or 0) + UDim2.fromOffset(offset.x or 0, offset.y or 0)
                appliedOffsets[key] = {x = offset.x or 0, y = offset.y or 0}
            end
        end
    end
    local function isInside(target, pos)
        if not target or not target.Visible or not target.Parent then return false end
        local a, z = target.AbsolutePosition, target.AbsoluteSize
        return pos.X >= a.X and pos.X <= a.X + z.X and pos.Y >= a.Y and pos.Y <= a.Y + z.Y
    end
    UserInputService.InputBegan:Connect(function(input, processed)
        if input.UserInputType ~= Enum.UserInputType.MouseButton2 or not Root.Visible then return end
        local pos = UserInputService:GetMouseLocation()
        for i = #previewDragTargets, 1, -1 do
            local target = previewDragTargets[i]
            if isInside(target, pos) then
                previewDragTarget = target
                previewDragStart = pos
                local o = previewOffsets[target.Name] or {x = 0, y = 0}
                previewDragOrigin = Vector2.new(o.x or 0, o.y or 0)
                break
            end
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not previewDragTarget then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local pos = UserInputService:GetMouseLocation()
            local delta = pos - previewDragStart
            local o = previewOffsets[previewDragTarget.Name]
            if o then o.x, o.y = previewDragOrigin.X + delta.X, previewDragOrigin.Y + delta.Y end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if previewDragTarget and input.UserInputType == Enum.UserInputType.MouseButton2 then previewDragTarget = nil end
    end)

    local WorldModel = Instance.new("WorldModel")
    WorldModel.Parent = ViewportFrame

    local model
    local ok = pcall(function()
        local objects = game:GetObjects("rbxassetid://126009530")
        if objects and #objects > 0 then model = objects[1] end
    end)

    if ok and model then
        if not model:IsA("Model") then
            local wrapper = Instance.new("Model")
            wrapper.Name = "WeaponPreviewModel"
            model.Parent = wrapper
            model = wrapper
        end
        model.Parent = WorldModel
        previewHighlight = Instance.new("Highlight")
        previewHighlight.Name = "ESPPreviewChams"
        previewHighlight.Adornee = model
        previewHighlight.Enabled = false
        previewHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        previewHighlight.Parent = WorldModel
        local centerCFrame, modelSize = model:GetBoundingBox()
        local modelRadius = math.max(modelSize.X, modelSize.Y, modelSize.Z) / 2
        local Camera = Instance.new("Camera")
        ViewportFrame.CurrentCamera = Camera
        Camera.Parent = ViewportFrame
        local Light = Instance.new("PointLight")
        Light.Color = Color3.fromRGB(255, 255, 255)
        Light.Brightness = 2
        Light.Range = modelRadius * 5
        Light.Parent = Camera
        local distance = math.clamp(modelRadius * 2.1, 2, 30)
        local angleX, angleY = 0, 0.15
        local isDragging = false
        local isHoveringViewport = false
        local lastMousePosition = Vector2.new()
        local autoRotate = false
        local lastInteractionTime = 0

        local function onMouseWheelAction(_, _, _)
            if isHoveringViewport then return Enum.ContextActionResult.Sink end
            return Enum.ContextActionResult.Pass
        end
        ContextActionService:BindActionAtPriority(
            ACTION_NAME,
            onMouseWheelAction,
            false,
            Enum.ContextActionPriority.High.Value,
            Enum.UserInputType.MouseWheel
        )

        ViewportFrame.MouseEnter:Connect(function() isHoveringViewport = true end)
        ViewportFrame.MouseLeave:Connect(function()
            isHoveringViewport = false
        end)
        ViewportFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = true
                autoRotate = false
                lastMousePosition = input.Position
                lastInteractionTime = os.clock()
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = false
                lastInteractionTime = os.clock()
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - lastMousePosition
                lastMousePosition = input.Position
                angleX = angleX - delta.X * 0.008
                angleY = math.clamp(angleY - delta.Y * 0.008, -math.pi / 2.2, math.pi / 2.2)
                lastInteractionTime = os.clock()
            end
        end)
        ViewportFrame.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseWheel then
                distance = math.clamp(
                    distance - input.Position.Z * (modelRadius * 0.2),
                    modelRadius * 0.5,
                    modelRadius * 6
                )
            end
        end)
        RunService.RenderStepped:Connect(function(dt)
            applyPreviewOffsets(-1)
            updateESPPreview()
            applyPreviewOffsets(1)
            local focus = centerCFrame.Position
            local cf = CFrame.new(focus) * CFrame.Angles(0, angleX, 0) * CFrame.Angles(angleY, 0, 0) * CFrame.new(0, 0, distance)
            Camera.CFrame = CFrame.new(cf.Position, focus)
        end)
    else
        warn("[Thorium3DPreview] failed to load model")
    end

    Thorium3DPreview = Root

    RunService.RenderStepped:Connect(function()
        if not Thorium3DPreview or not MainFrame then return end
        local menuVisible = MainFrame.Visible and MainFrame.GroupTransparency < 1
        local onVisualsTab = (currentActiveTab == "Visuals" and currentVisualSubTab == "Visuals")
        if not menuVisible or not onVisualsTab then
            if Thorium3DPreview.Visible then Thorium3DPreview.Visible = false end
            return
        end
        local mp = MainFrame.AbsolutePosition
        local ms = MainFrame.AbsoluteSize
        if ms.X <= 0 or ms.Y <= 0 then return end
        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
        if UserInputService.TouchEnabled or viewport.X < 1050 then
            local panelW = math.clamp(math.floor(viewport.X * 0.42), 145, 250)
            local panelH = math.clamp(math.floor(math.min(viewport.Y * 0.34, ms.Y - 64)), 190, 300)
            Thorium3DPreview.Position = UDim2.new(0, math.max(8, mp.X + ms.X - panelW - 8), 0, math.max(8, mp.Y + ms.Y - panelH - 8))
            Thorium3DPreview.Size = UDim2.new(0, panelW, 0, panelH)
        else
            Thorium3DPreview.Position = UDim2.new(0, mp.X + ms.X + GAP, 0, mp.Y)
            Thorium3DPreview.Size = UDim2.new(0, 300, 0, ms.Y)
        end
        if not Thorium3DPreview.Visible then Thorium3DPreview.Visible = true end
    end)
end



