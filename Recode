    local function destroyFollower()
        followerEnabled = false
        if followerConnection then followerConnection:Disconnect(); followerConnection = nil end
        if followerModel then pcall(function() followerModel:Destroy() end); followerModel = nil end
    end
    local function createFollower()
        destroyFollower()
        local character = LocalPlayer and LocalPlayer.Character
        if not character or not character.Parent then
            setFollowerStatus("Waiting for your character to load...", false)
            return
        end
        local root = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid then
            setFollowerStatus("Character root not found. Try again after respawning.", false)
            return
        end
        local wasArchivable = character.Archivable
        character.Archivable = true
        local ok, clone = pcall(function() return character:Clone() end)
        character.Archivable = wasArchivable
        if not ok or not clone then
            setFollowerStatus("Could not clone this character.", false)
            return
        end
        clone.Name = "Sw1niumLocalFollower"
        for _, item in ipairs(clone:GetDescendants()) do
            if item:IsA("Script") or item:IsA("LocalScript") or item:IsA("ModuleScript") then
                item:Destroy()
            elseif item:IsA("BasePart") then
                item.CanCollide = false
                item.CanTouch = false
                item.CanQuery = false
                item.Massless = true
                item.Anchored = true
            elseif item:IsA("ParticleEmitter") or item:IsA("Trail") or item:IsA("Beam") then
                item.Enabled = false
            end
        end
        local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
        if cloneHumanoid then
            cloneHumanoid.DisplayName = "Follower"
            cloneHumanoid.NameDisplayDistance = 0
            cloneHumanoid.HealthDisplayDistance = 0
            cloneHumanoid.PlatformStand = true
            pcall(function() cloneHumanoid:ChangeState(Enum.HumanoidStateType.Physics) end)
        end
        clone.Parent = workspace
        local cloneRoot = clone:FindFirstChild("HumanoidRootPart")
        if not cloneRoot then clone:Destroy(); setFollowerStatus("Clone has no root part.", false); return end
        followerModel = clone
        followerEnabled = true
        local initial = root.CFrame * CFrame.new(0, 0, 5)
        clone:PivotTo(initial)
        local lastUpdate = 0
        followerConnection = RunService.Heartbeat:Connect(function(dt)
            if not followerEnabled or not followerModel or not followerModel.Parent then return end
            local liveCharacter = LocalPlayer and LocalPlayer.Character
            local liveRoot = liveCharacter and liveCharacter:FindFirstChild("HumanoidRootPart")
            if not liveRoot then return end
            lastUpdate = lastUpdate + dt
            if lastUpdate < 1/30 then return end
            local step = lastUpdate
            lastUpdate = 0
            local target = liveRoot.CFrame * CFrame.new(0, 0, 5)
            local current = followerModel:GetPivot()
            local alpha = math.clamp(step * 9, 0, 1)
            followerModel:PivotTo(current:Lerp(target, alpha))
        end)
        setFollowerStatus("Follower active • local only • no collision", true)
    end
