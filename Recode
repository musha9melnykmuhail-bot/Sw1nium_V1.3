ResizeGrip.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        resizeState.active = true
        resizeState.start = input.Position
        resizeState.width, resizeState.height = menuWidth, menuHeight
        dragState.active = false
        TweenService:Create(resizeGripStroke, TweenInfo.new(0.12, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Color = C_ACCENT}):Play()
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if resizeState.active and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - resizeState.start
        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
        local compact = UserInputService.TouchEnabled or viewport.X < 760
        local minW = compact and math.min(320, viewport.X - 16) or MENU_MIN_W
        local maxW = compact and math.max(320, viewport.X - 16) or MENU_MAX_W
        local minH = compact and math.min(360, viewport.Y - 20) or MENU_MIN_H
        local maxH = compact and math.max(360, viewport.Y - 20) or MENU_MAX_H
        menuWidth = math.clamp(math.floor(resizeState.width + delta.X + 0.5), minW, maxW)
        menuHeight = math.clamp(math.floor(resizeState.height + delta.Y + 0.5), minH, maxH)
        MainFrame.Size = UDim2.new(0, menuWidth, 0, menuHeight)
        if SearchResults then
            SearchResults.Size = UDim2.new(0, math.min(420, math.max(300, menuWidth - 220)), 0, SearchResults.Size.Y.Offset)
        end
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 and resizeState.active then
        resizeState.active = false
        TweenService:Create(resizeGripStroke, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Color = C_BORDER}):Play()
        TweenService:Create(ResizeGrip, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {TextColor3 = C_MUTED}):Play()
    end
end)


