    local function getTabFrames()
        local result = {}
        for _, child in ipairs(TabContainer:GetChildren()) do
            if child:IsA("Frame") and child ~= itemFrame and not child.Name:match("^AutoSubnav_") and child.Name ~= "SkinchangerSubBar" then
                result[#result + 1] = child
            end
        end
        return result
    end

    local function reorderTabs(mouseY)
        local frames = getTabFrames()
        table.sort(frames, function(a,b) return a.LayoutOrder < b.LayoutOrder end)
        local target = itemFrame.LayoutOrder
        for _, other in ipairs(frames) do
            local center = other.AbsolutePosition.Y + other.AbsoluteSize.Y * 0.5
            if mouseY > center then
                target = other.LayoutOrder
            end
        end
        if target ~= itemFrame.LayoutOrder then
            local oldOrder = itemFrame.LayoutOrder
            if target > oldOrder then
                for _, other in ipairs(frames) do
                    if other.LayoutOrder > oldOrder and other.LayoutOrder <= target then
                        other.LayoutOrder = other.LayoutOrder - 1
                    end
                end
            else
                for _, other in ipairs(frames) do
                    if other.LayoutOrder >= target and other.LayoutOrder < oldOrder then
                        other.LayoutOrder = other.LayoutOrder + 1
                    end
                end
            end
            itemFrame.LayoutOrder = target
        end
    end

    itemFrame.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        tabDrag.armed = true
        tabDrag.active = false
        tabDrag.start = input.Position
        tabToken = tabToken + 1
        local token = tabToken
        task.delay(1, function()
            if tabDrag.armed and token == tabToken and itemFrame.Parent then
                tabDrag.active = true
                tabDrag.consumed = true
                S.isInteracting = true
                TweenService:Create(itemFrame, TweenInfo.new(0.15), {BackgroundTransparency = 0.15}):Play()
            end
        end)
    end)

    itemFrame.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        tabDrag.armed = false
        tabToken = tabToken + 1
        if tabDrag.active then
            tabDrag.active = false
            S.isInteracting = false
            TweenService:Create(itemFrame, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if tabDrag.active and input.UserInputType == Enum.UserInputType.MouseMovement then
            reorderTabs(input.Position.Y)
        end
    end)

    btn.MouseButton1Click:Connect(function()
        if tabDrag.consumed then
            tabDrag.consumed = false
            return
        end
        __SW_SwitchTab(name)
    end)
    TabButtons[name] = {Frame = itemFrame, Button = btn, Pill = pill, Icon = icon, Drag = tabDrag}
end

