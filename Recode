    end)
end

function __SW_SendChatMessage(text)
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        if rs:FindFirstChild("DefaultChatSystemChatEvents") then
            rs.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(text, "All")
        else
            local chat = game:GetService("TextChatService")
            local ch = chat.TextChannels and chat.TextChannels:FindFirstChild("RBXGeneral")
            if ch then ch:SendAsync(text) end
        end
    end)
end

function __SW_StopChatSpam()
    if Troll.spamConn then Troll.spamConn:Disconnect(); Troll.spamConn = nil end
end
function __SW_StartChatSpam()
    __SW_StopChatSpam()
    Troll.spamConn = task.spawn(function()
        while Troll.chatSpam do
            __SW_SendChatMessage(Troll.chatText)
            task.wait(Troll.spamInterval)
        end
    end)
end




