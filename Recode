local tabTransitionToken = 0
function __SW_SwitchTab(targetName)
    if not Pages[targetName] then return end
    if currentActiveTab == targetName then
        if animateAutoSubnav then animateAutoSubnav(targetName) end
        if VisualSubBar then VisualSubBar.Visible = (targetName == "Visuals") end
        if SettingsSubBar then SettingsSubBar.Visible = (targetName == "Setting") end
        if S.SkinchangerSubBar then S.SkinchangerSubBar.Visible = (targetName == "Skinchanger") end
        return
    end
    tabTransitionToken = tabTransitionToken + 1
    local token = tabTransitionToken
    local previousName = currentActiveTab
    local previousData = previousName and Pages[previousName] or nil
    currentActiveTab = targetName
    if animateAutoSubnav then animateAutoSubnav(targetName) end
    if VisualSubBar then VisualSubBar.Visible = (targetName == "Visuals") end
    if SettingsSubBar then SettingsSubBar.Visible = (targetName == "Setting") end
    if S.SkinchangerSubBar then S.SkinchangerSubBar.Visible = (targetName == "Skinchanger") end

    for name, btnData in pairs(TabButtons) do
        local isCurrent = (name == targetName)
        local tw = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        TweenService:Create(btnData.Pill, tw, {BackgroundTransparency = isCurrent and 0 or 1}):Play()
        TweenService:Create(btnData.Icon, tw, {ImageColor3 = isCurrent and C_ACCENT or C_MUTED}):Play()
        TweenService:Create(btnData.Button, tw, {TextColor3 = isCurrent and C_ACCENT or C_MUTED}):Play()
        TweenService:Create(btnData.Frame, tw, {BackgroundTransparency = isCurrent and 0 or 1}):Play()
        btnData.Button.Font = isCurrent and Enum.Font.BuilderSansBold or Enum.Font.BuilderSansMedium
    end

    task.spawn(function()
        local fading = 0
        for name, data in pairs(Pages) do
            if name ~= targetName and data.Page and data.Page.Visible and data.Canvas then
                fading = fading + 1
                TweenService:Create(data.Canvas, TweenInfo.new(0.11, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    GroupTransparency = 1,
                    Position = UDim2.new(0, -5, 0, 0),
                }):Play()
            end
        end
        if fading > 0 then task.wait(0.11) end
        if token ~= tabTransitionToken then return end
        for name, data in pairs(Pages) do
            if name ~= targetName then
                data.Page.Visible = false
                if data.Canvas then
                    data.Canvas.GroupTransparency = 0
                    data.Canvas.Position = UDim2.new(0, 0, 0, 0)
                end
            end
        end
        local data = Pages[targetName]
        if data and data.Page then
            data.Page.Visible = true
            if data.Canvas then
                data.Canvas.GroupTransparency = 1
                data.Canvas.Position = UDim2.new(0, 8, 0, 0)
                TweenService:Create(data.Canvas, TweenInfo.new(0.30, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                    GroupTransparency = 0,
                    Position = UDim2.new(0, 0, 0, 0),
                }):Play()
            end
        end
    end)
end

