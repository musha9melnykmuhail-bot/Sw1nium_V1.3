local function __SW_SetMenuMouseMode(open)
    if open then
        _swSavedMouseIcon = UserInputService.MouseIconEnabled
        _swSavedMouseBehavior = UserInputService.MouseBehavior
        pcall(function()
            UserInputService.MouseIconEnabled = true
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end)
    else
        pcall(function()
            if _swSavedMouseIcon ~= nil then UserInputService.MouseIconEnabled = _swSavedMouseIcon end
            if _swSavedMouseBehavior ~= nil then UserInputService.MouseBehavior = _swSavedMouseBehavior end
        end)
        _swSavedMouseIcon = nil
        _swSavedMouseBehavior = nil
    end
end

function __SW_ToggleUI()
    if uiState.animating then return end
    uiState.animating = true
    uiState.visible = not uiState.visible
    if uiState.visible then
        __SW_SetMenuMouseMode(true)
        MainFrame.Visible = true
        ScreenBlur.Enabled = not S._focusMode
        DimOverlay.Visible = true
        TweenService:Create(DimOverlay, TweenInfo.new(0.35), {BackgroundTransparency = S._focusMode and 1 or 0.75}):Play()
        TweenService:Create(ScreenBlur, TweenInfo.new(0.35), {Size = S._focusMode and 0 or 14}):Play()
        MainFrame.Size = UDim2.new(0, menuWidth * 0.97, 0, menuHeight * 0.97)
        local t = TweenService:Create(MainFrame, TweenInfo.new(0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {GroupTransparency = 0, Size = UDim2.new(0, menuWidth, 0, menuHeight)})
        t:Play()
        t.Completed:Connect(function() uiState.animating = false end)
    else
        __SW_SetMenuMouseMode(false)
