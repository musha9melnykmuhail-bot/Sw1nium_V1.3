Troll.FlingTarget = function(targetPlr)
    if not targetPlr or targetPlr == LocalPlayer then return false end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return false end
    local delta = targetRoot.Position - myRoot.Position
    local dir = delta.Magnitude > 0.01 and delta.Unit or Vector3.new(0, 0, -1)
    local bv = Instance.new("BodyVelocity")
    bv.Name = "Torium_FlingVelocity"
    bv.Velocity = dir * 500 + Vector3.new(0, 200, 0)
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.P = 10000
    bv.Parent = targetRoot
    task.delay(0.3, function()
        if bv and bv.Parent then pcall(function() bv:Destroy() end) end
    end)
    return true
end

Troll.StartAntiFling = function()
    if Troll.antiFlingConn then Troll.antiFlingConn:Disconnect() end
    Troll.antiFlingConn = RunService.Heartbeat:Connect(function()
        if not Troll.antiFling then return end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        pcall(function()
            local velocity = root.AssemblyLinearVelocity
            if velocity.Magnitude > 85 then
                root.AssemblyLinearVelocity = velocity.Unit * 35
            end
            local angular = root.AssemblyAngularVelocity
            if angular.Magnitude > 45 then
                root.AssemblyAngularVelocity = angular.Unit * 12
            end
        end)
    end)
end

Troll.StopAntiFling = function()
    if Troll.antiFlingConn then
        Troll.antiFlingConn:Disconnect()
        Troll.antiFlingConn = nil
    end
end

Troll.StopAntiAim = function()
    if Troll.antiAimConn then
        Troll.antiAimConn:Disconnect()
        Troll.antiAimConn = nil
    end
end

Troll.StartAntiAim = function()
    Troll.StopAntiAim()
    Troll.antiAimTick = 0
    Troll.antiAimFlip = false
    Troll.antiAimConn = RunService.Heartbeat:Connect(function(dt)
        if not Troll.antiAim then return end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        Troll.antiAimTick = Troll.antiAimTick + dt
        local mode = Troll.antiAimMode
        local yaw = 0
        if mode == "Backwards" then
            yaw = math.pi
        elseif mode == "Jitter" then
            if Troll.antiAimTick >= 0.10 then
                Troll.antiAimTick = 0
                Troll.antiAimFlip = not Troll.antiAimFlip
            end
            yaw = math.rad(Troll.antiAimFlip and 75 or -75)
        elseif mode == "Random" then
            if Troll.antiAimTick >= 0.12 then
                Troll.antiAimTick = 0
                Troll.antiAimFlip = not Troll.antiAimFlip
                Troll._antiAimYaw = math.rad(math.random(-180, 180))
            end
            yaw = Troll._antiAimYaw or 0
        elseif mode == "Spin" then
            yaw = math.rad((os.clock() * 720) % 360)
        end
        pcall(function()
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
        end)
    end)
end

