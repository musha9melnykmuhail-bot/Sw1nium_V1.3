function __SW_GetCaptureBinding(input)
    local keyName
    if input.UserInputType == Enum.UserInputType.Keyboard then
        local kc = input.KeyCode
        if kc == Enum.KeyCode.Escape then return "CLEAR" end
        if kc == Enum.KeyCode.Backspace then return "CLEAR" end
        if kc == Enum.KeyCode.LeftControl or kc == Enum.KeyCode.RightControl
            or kc == Enum.KeyCode.LeftShift or kc == Enum.KeyCode.RightShift
            or kc == Enum.KeyCode.LeftAlt or kc == Enum.KeyCode.RightAlt then
            return nil
        end
        keyName = kc.Name
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
        keyName = "MouseButton1"
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        keyName = "MouseButton2"
    elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
        keyName = "MouseButton3"
    else
        return nil
    end
    return {
        Name = keyName,
        Ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl),
        Shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift),
        Alt = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt),
    }
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if BindingCapture then
        local cap = BindingCapture
        local b = __SW_GetCaptureBinding(input)
        if b == "CLEAR" then
            cap.SetBinding(nil)
            cap.CaptureButton.Text = "None"
            cap.CaptureButton.TextColor3 = Color3.fromRGB(160, 160, 185)
            BindingCapture = nil
        elseif b then
            cap.SetBinding(b)
            BindingCapture = nil
        end
        return
    end
    if gameProcessed then return end
    for _, item in ipairs(ActiveBinds) do
        if item.Trigger then item.Trigger(input) end
    end
end)

function __SW_ApplyKeybindSettings()
    local cfg = S.KeybindSettings
    local alpha = math.clamp((cfg.Transparency or 0) / 100, 0, 1)
    KeybindContainer.BackgroundColor3 = C_CARD
    KeybindContainer.BackgroundTransparency = alpha
    
    -- Получаем текущую целевую ширину из конфига
    local targetW = math.clamp(cfg.Width or 190, 150, 700)
    KeybindContainer.Size = UDim2.new(0, targetW, 0, KeybindContainer.Size.Y.Offset)
    
    kbStroke.Color = cfg.Color or C_BORDER
    kbStroke.Transparency = math.clamp(alpha * 0.35, 0, 1)
    kbHeader.TextColor3 = C_HEADER_TEXT
    for _, item in ipairs(ActiveBinds) do
        if item.KeyLabel then item.KeyLabel.TextColor3 = cfg.Color or C_ACCENT end
    end
    if KeybindPanel then
        KeybindPanel.Size = UDim2.new(0, math.clamp(cfg.Width or 500, 400, 760), 0, math.clamp(cfg.Height or 430, 320, 650))
        KeybindPanel.Position = UDim2.new(0.5, -KeybindPanel.Size.X.Offset / 2, 0.5, -KeybindPanel.Size.Y.Offset / 2)
        local panelStroke = KeybindPanel:FindFirstChildOfClass("UIStroke")
        if panelStroke then panelStroke.Color = cfg.Color or C_BORDER end
    end
end

function __SW_UpdateKeybindContainerHeight()
    local activeCount = 0
    for _, item in pairs(ActiveBinds) do
        if item.Frame.Visible then activeCount = activeCount + 1 end
    end
    local enabled = S.KeybindSettings and S.KeybindSettings.Enabled ~= false
    KeybindContainer.Visible = enabled and activeCount > 0
    local targetH = 22 + (activeCount * 18) + (activeCount > 0 and 4 or 0)
    
    -- Берем ширину динамически, чтобы твин не сбрасывал ее к дефолтным 190, если в конфиге указано иное
    local currentW = KeybindContainer.Size.X.Offset
    TweenService:Create(KeybindContainer, TweenInfo.new(0.15), {Size = UDim2.new(0, currentW, 0, targetH)}):Play()
end

