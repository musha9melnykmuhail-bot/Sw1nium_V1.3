                ShadowSoftness = Lighting.ShadowSoftness, Technology = tostring(Lighting.Technology),
            },
            FrozenTime = S.WorldState.frozenTime,
            FrozenTimeValue = S.WorldState.frozenTimeValue,
            SkyPreset = S.WorldState.skyPreset or false,
        },
        SafeMode = S.SafeMode,
        Meta = {Version = ConfigMgr.Version, SavedAt = os.time()},
    }
    local encodeOk, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if not encodeOk then __SW_ShowNotification("Config encode failed: " .. tostring(encoded), false); return false end
    local ok, err = pcall(function() writefile(ConfigMgr.Path(name), encoded) end)
    if ok then __SW_ShowNotification("Saved: " .. name, true) else __SW_ShowNotification("Save failed: " .. tostring(err), false) end
    return ok
end

function __SW_parseColor(s, fallback)
    if typeof(s) == "Color3" then return s end
    if type(s) == "string" then
        local r, g, b = s:match("([%d%.]+),([%d%.]+),([%d%.]+)")
        if r and g and b then return Color3.new(tonumber(r), tonumber(g), tonumber(b)) end
    end
    return fallback or Color3.new(1,1,1)
end


function ConfigMgr.Load(name)
    if not readfile then __SW_ShowNotification("readfile unavailable", false); return false end
    name = __SW_sanitizeConfigName(name)
    __SW_ensureFolder()
    local path = ConfigMgr.Path(name)
    if not (isfile and isfile(path)) then __SW_ShowNotification("Not found: " .. name, false); return false end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or type(data) ~= "table" then __SW_ShowNotification("Load failed", false); return false end

    if type(data.ESPPreviewOffsets) == "table" then
        S.ESPPreviewOffsets = S.ESPPreviewOffsets or {}
        table.clear(S.ESPPreviewOffsets)
        for key, value in pairs(data.ESPPreviewOffsets) do
            if type(key) == "string" and type(value) == "table" then
                S.ESPPreviewOffsets[key] = {x = tonumber(value.x) or 0, y = tonumber(value.y) or 0}
            end
        end
    end

    if data.ESP then
        local E = data.ESP
        local function set(k, v) if v ~= nil then ESP[k] = v end end
        for _, k in ipairs({"Enabled","Boxes","BoxType","BoxThickness","Names","NameSize","ShowRole","Distance","Health","HealthText","Tracers","TracerOrigin","Chams","ChamsType","ChamsTransparency","Skeleton","SkeletonThickness","MaxDistance","TeamCheck","IgnoreDead","UseRoleColors","Arrows","ArrowRadius","ArrowSize"}) do set(k, E[k]) end
        if E.DistanceColor then ESP.DistanceColor = __SW_parseColor(E.DistanceColor, ESP.DistanceColor) end
        if E.HealthColor then ESP.HealthColor = __SW_parseColor(E.HealthColor, ESP.HealthColor) end
        if E.SkeletonColor then ESP.SkeletonColor = __SW_parseColor(E.SkeletonColor, ESP.SkeletonColor) end
        if E.ArrowColor then ESP.ArrowColor = __SW_parseColor(E.ArrowColor, ESP.ArrowColor) end
        if type(E.RoleColors) == "table" then
            for roleName, fields in pairs(E.RoleColors) do
                if ESP.Colors[roleName] and type(fields) == "table" then
                    for _, colorKey in ipairs({"Box", "Chams", "Name", "Tracer"}) do
                        if fields[colorKey] then ESP.Colors[roleName][colorKey] = __SW_parseColor(fields[colorKey], ESP.Colors[roleName][colorKey]) end
                    end
                end
            end
        end
        if ESP.Enabled then pcall(__SW_UpdateESP) else pcall(ESP.FullCleanup) end
    end

    if data.Combat then
        local C = data.Combat
        for _, k in ipairs({"killAll","killAllRange","killAllDelay","autoShoot","autoShootDelay","autoGrabGun","autoGrabKnife","autoStab","autoStabRange","autoTeleKill","silentAim","fovCircle","fovRadius","aimAssist","aimSmoothness","autoReload","hitbox","visibleOnly","maxDistance"}) do
            if C[k] ~= nil then CM[k] = C[k] end
        end
        if C.fovColor then CM.fovColor = __SW_parseColor(C.fovColor, CM.fovColor) end
        if CM.killAll then __SW_CM_StartKillAll() else __SW_CM_StopKillAll() end
        if CM.autoShoot then __SW_CM_StartAutoShoot() else __SW_CM_StopAutoShoot() end
        if CM.autoGrabGun then __SW_CM_StartAutoGrabGun() else __SW_CM_StopAutoGrabGun() end
        if CM.autoGrabKnife then __SW_CM_StartAutoGrabKnife() else __SW_CM_StopAutoGrabKnife() end
        if CM.autoStab then __SW_CM_StartAutoStab() else __SW_CM_StopAutoStab() end
        if CM.autoTeleKill then __SW_CM_StartAutoTeleKill() else __SW_CM_StopAutoTeleKill() end
        if CM.silentAim then __SW_CM_StartSilentAim() else __SW_CM_StopSilentAim() end
        if CM.aimAssist then __SW_CM_StartAimAssist() else __SW_CM_StopAimAssist() end
        if CM.autoReload then __SW_CM_StartAutoReload() else __SW_CM_StopAutoReload() end
    end

    if data.Movement then
        local M = data.Movement
        for _, k in ipairs({"speedhack","speedValue","infiniteJump","bunnyhop","noclip","flyEnabled","flySpeed","jumpPower","autoSprint","sprintKey","sprintSpeed","wallClimb","wallClimbSpeed"}) do if M[k] ~= nil then Movement[k] = M[k] end end
        if Movement.flyEnabled then pcall(__SW_StartFly) else pcall(__SW_StopFly) end
        if Movement._jumpConn then Movement._jumpConn:Disconnect(); Movement._jumpConn = nil end
        if Movement._noclipConn then Movement._noclipConn:Disconnect(); Movement._noclipConn = nil end
        if Movement._bhopConn then Movement._bhopConn:Disconnect(); Movement._bhopConn = nil end
        if Movement._wallClimbConn then Movement._wallClimbConn:Disconnect(); Movement._wallClimbConn = nil end
        if LocalPlayer.Character then pcall(__SW_ApplyMovementOnCharacter, LocalPlayer.Character) end
        if not Movement.speedhack then pcall(function()
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum and Movement._defaultWalkSpeed then hum.WalkSpeed = Movement._defaultWalkSpeed end
        end) end
    end

    if data.Weapon then
        local Wp = data.Weapon
        for _, k in ipairs({"Highlight","Names","Distance","MaxDistance","ScanInterval","DroppedOnly","AutoRotate"}) do if Wp[k] ~= nil then S.WeaponState[k] = Wp[k] end end
        S.SetWeaponESP(Wp.Enabled == true)
    end

    if data.ElementManager then
        for k, v in pairs(data.ElementManager) do if S.ElementManager[k] ~= nil and v ~= nil then S.ElementManager[k] = v end end
        NotifyContainer.Visible = S.ElementManager.Notifications
    end

    if data.Keybinds then
        local K = data.Keybinds
        if K.Enabled ~= nil then S.KeybindSettings.Enabled = K.Enabled end
        if K.Transparency ~= nil then S.KeybindSettings.Transparency = K.Transparency end
        if K.Color then S.KeybindSettings.Color = __SW_parseColor(K.Color, S.KeybindSettings.Color) end
        for _, k in ipairs({"Width","Height","CornerRadius","ShowDescription"}) do if K[k] ~= nil then S.KeybindSettings[k] = K[k] end end
        __SW_ApplyKeybindSettings(); __SW_UpdateKeybindContainerHeight()
    end

    if data.World then
        local WD = data.World
        local L = WD.Lighting
        if type(L) == "table" then
            for _, k in ipairs({"Brightness","ExposureCompensation","EnvironmentDiffuseScale","EnvironmentSpecularScale","GlobalShadows","ClockTime","GeographicLatitude","FogEnd","FogStart","ShadowSoftness"}) do
                if L[k] ~= nil then pcall(function() Lighting[k] = L[k] end) end
            end
            for _, k in ipairs({"Ambient","OutdoorAmbient","ColorShift_Top","ColorShift_Bottom","FogColor"}) do
                if L[k] then
                    local fallback = Lighting[k]
                    local color = __SW_parseColor(L[k], fallback)
                    pcall(function() Lighting[k] = color end)
                end
            end
        end
        if WD.FrozenTime ~= nil then S.WorldState.frozenTime = WD.FrozenTime == true end
        if WD.FrozenTimeValue ~= nil then S.WorldState.frozenTimeValue = tonumber(WD.FrozenTimeValue) or Lighting.ClockTime end
        if S.WorldState.frozenTime then pcall(function() Lighting.ClockTime = S.WorldState.frozenTimeValue end) end
        if WD.SkyPreset and S.WorldUtil and S.WorldUtil.setSky then
            pcall(function() S.WorldUtil.setSky(WD.SkyPreset) end)
        elseif WD.SkyPreset == false and S.WorldUtil and S.WorldUtil.removeSky then
            pcall(function() S.WorldUtil.removeSky() end)
        end
    end

    if data.Troll then
        local T = data.Troll
        for _, k in ipairs({"spinbot","spinSpeed","antiAim","antiAimMode","antiFling","chatSpam","chatText","spamInterval"}) do if T[k] ~= nil then Troll[k] = T[k] end end
        if Troll.spinbot then __SW_StartSpinbot() else __SW_StopSpinbot() end
        if Troll.antiAim then Troll.StartAntiAim() else Troll.StopAntiAim() end
        if Troll.antiFling then Troll.StartAntiFling() else Troll.StopAntiFling() end
        if Troll.chatSpam then __SW_StartChatSpam() else __SW_StopChatSpam() end
    end

    if data.MenuStyle then
        local M = data.MenuStyle
        for _, k in ipairs({"BackgroundImage","BackgroundTransparency","BackgroundImageTransparency","CornerRadius","BackgroundBlur","BackgroundBlurSize"}) do if M[k] ~= nil then S.MenuStyle[k] = M[k] end end
        for _, k in ipairs({"Accent","Background","Sidebar","Card","Border","Muted"}) do if M[k] then S.MenuStyle[k] = __SW_parseColor(M[k], S.MenuStyle[k]) end end
        __SW_ApplyMenuCustomization()
        __SW_ApplyBackgroundBlur()
    end

    if data.SafeMode ~= nil then __SW_SetSafeMode(data.SafeMode) end
    __SW_ShowNotification("Loaded: " .. name, true)
    return true
end

function ConfigMgr.Delete(name)
    if not delfile then __SW_ShowNotification("delfile unavailable", false); return false end
    name = __SW_sanitizeConfigName(name)
    local path = ConfigMgr.Path(name)
    if not (isfile and isfile(path)) then __SW_ShowNotification("Not found", false); return false end
    local ok = pcall(function() delfile(path) end)
    if ok then __SW_ShowNotification("Deleted: " .. name, false) else __SW_ShowNotification("Delete failed", false) end
    return ok
end



