function __SW_SetSafeMode(enabled)
    S.SafeMode = enabled == true
    for _, t in ipairs(S.SafeModeToggles) do
        if t and t.SetLocked then pcall(t.SetLocked, t, S.SafeMode) end
    end
    if S.UpdateProfileSafeMode then pcall(S.UpdateProfileSafeMode, S.SafeMode) end
    __SW_ShowNotification("Safe Mode", S.SafeMode)
end

