function __SW_CM_StartAutoStab()
    __SW_CM_StopAutoStab()
    CM.autoStabConn = RunService.Heartbeat:Connect(function()
        if not CM.autoStab then return end
        if __SW_CM_GetMyRole() ~= "Murderer" then return end
        local knife = __SW_CM_GetTool("Knife")
        if not knife then return end
        __SW_CM_Equip(knife)
        local target = __SW_CM_NearestByDist("enemy", CM.autoStabRange)
        if target then
            pcall(function() knife:Activate() end)
            for _, part in ipairs(target.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function()
                        if firetouchinterest then
                            firetouchinterest(part, part, 0)
                            firetouchinterest(part, part, 1)
                        end
                    end)
                end
            end
        end
    end)
end

function __SW_CM_StopAutoTeleKill() if CM.autoTeleKillConn then CM.autoTeleKillConn:Disconnect(); CM.autoTeleKillConn = nil end end
function __SW_CM_StartAutoTeleKill()
    __SW_CM_StopAutoTeleKill()
    CM.autoTeleKillConn = RunService.Heartbeat:Connect(function()
        if not CM.autoTeleKill then return end
        if __SW_CM_GetMyRole() ~= "Murderer" then return end
        local knife = __SW_CM_GetTool("Knife")
        if not knife then return end
        __SW_CM_Equip(knife)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local role = __SW_DetectRole(plr)
                if role ~= "Murderer" and role ~= "Unknown" then
                    local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and myRoot then
                        pcall(function()
                            myRoot.CFrame = hrp.CFrame * CFrame.new(0, 0, 2)
                        end)
                        pcall(function() knife:Activate() end)
                        for _, part in ipairs(plr.Character:GetDescendants()) do
                            if part:IsA("BasePart") then
                                pcall(function()
                                    if firetouchinterest then
                                        firetouchinterest(part, part, 0)
                                        firetouchinterest(part, part, 1)
                                    end
                                end)
                            end
                        end
                    end
                end
            end
        end
    end)
end

function __SW_CM_StopSilentAim() if CM.silentAimConn then CM.silentAimConn:Disconnect(); CM.silentAimConn = nil end end
function __SW_CM_StartSilentAim()
    __SW_CM_StopSilentAim()
    CM.silentAimConn = RunService.RenderStepped:Connect(function()
        if not CM.silentAim then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local target = __SW_CM_NearestInFov("any")
        if target then
            local part = __SW_CM_Hitbox(target)
            if part then
                pcall(function()
                    cam.CFrame = CFrame.new(cam.CFrame.Position, part.Position)
                end)
            end
        end
    end)
end

function __SW_CM_UpdateFov()
    if not CM.fovCircle or not S.hasDrawing then
        if CM._fovDrawing then CM._fovDrawing.Visible = false end
        return
    end
    if not CM._fovDrawing then
        CM._fovDrawing = __SW_SafeDrawing("Circle", {
            Thickness = 1.5, Transparency = 0.4, Filled = false,
            Color = CM.fovColor, Visible = false,
        })
    end
    local cam = workspace.CurrentCamera
    if not cam or not CM._fovDrawing then return end
    CM._fovDrawing.Position = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    CM._fovDrawing.Radius = CM.fovRadius
    CM._fovDrawing.Color = CM.fovColor
    CM._fovDrawing.Visible = true
end
RunService.RenderStepped:Connect(__SW_CM_UpdateFov)

function __SW_CM_StopAimAssist() if CM.aimAssistConn then CM.aimAssistConn:Disconnect(); CM.aimAssistConn = nil end end
function __SW_CM_StartAimAssist()
    __SW_CM_StopAimAssist()
    CM.aimAssistConn = RunService.RenderStepped:Connect(function()
        if not CM.aimAssist then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local target = __SW_CM_NearestInFov("murderer") or __SW_CM_NearestInFov("enemy")
        if target then
            local part = __SW_CM_Hitbox(target)
            if part then
                local goal = CFrame.new(cam.CFrame.Position, part.Position)
                cam.CFrame = cam.CFrame:Lerp(goal, 1 / math.max(CM.aimSmoothness, 1))
            end
        end
    end)
end

function __SW_CM_StopAutoReload() if CM.autoReloadConn then CM.autoReloadConn:Disconnect(); CM.autoReloadConn = nil end end
function __SW_CM_StartAutoReload()
    __SW_CM_StopAutoReload()
    CM.autoReloadConn = RunService.Heartbeat:Connect(function()
        if not CM.autoReload then return end
        local gun = __SW_CM_GetTool("Gun") or __SW_CM_GetTool("Revolver")
        if not gun then return end
        local ammo = gun:FindFirstChild("Ammo") or gun:FindFirstChild("Clip") or gun:FindFirstChild("CurrentAmmo")
        if ammo and typeof(ammo) == "ValueBase" and ammo.Value <= 0 then
            pcall(function() gun:Activate() end)
            pcall(function()
                if gun:FindFirstChild("Reload") and gun.Reload:IsA("RemoteEvent") then
                    gun.Reload:FireServer()
                end
            end)
        end
    end)
end

function __SW_CM_StopInfiniteAmmo()
    if CM.infiniteAmmoConn then CM.infiniteAmmoConn:Disconnect(); CM.infiniteAmmoConn = nil end
end

function __SW_CM_StartInfiniteAmmo()
    __SW_CM_StopInfiniteAmmo()
    CM.infiniteAmmoConn = RunService.Heartbeat:Connect(function()
        if not CM.infiniteAmmo then return end
        local gun = __SW_CM_GetTool("Gun") or __SW_CM_GetTool("Revolver")
        if not gun then return end
        for _, name in ipairs({"Ammo", "Clip", "CurrentAmmo", "Bullets", "CurrentBullets"}) do
            local value = gun:FindFirstChild(name)
            if value and (value:IsA("IntValue") or value:IsA("NumberValue")) then
                pcall(function() value.Value = math.max(value.Value, 999) end)
            end
        end
    end)
end

