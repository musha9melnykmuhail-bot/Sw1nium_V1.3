                        local handle = S.WeaponGetHandle(inst)
                        if handle then
                            local d = (cam.CFrame.Position - handle.Position).Magnitude
                            if not nearestDistance or d < nearestDistance then
                                nearest, nearestDistance = inst, d
                            end
                        end
                    end
                end
            end
