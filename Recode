        local function buildPreviewRig()
            local sourceCharacter = LocalPlayer and LocalPlayer.Character
            if not sourceCharacter then return false end
            local oldArchivable = sourceCharacter.Archivable
            local clone
            local okClone = pcall(function()
                sourceCharacter.Archivable = true
                clone = sourceCharacter:Clone()
            end)
            pcall(function() sourceCharacter.Archivable = oldArchivable end)
            if not okClone or not clone then return false end

            for _, obj in ipairs(clone:GetDescendants()) do
                if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("Tool")
                    or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                    or obj:IsA("Sound") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                    obj:Destroy()
                elseif obj:IsA("BasePart") then
                    obj.CanCollide = false
                    obj.CanTouch = false
                    obj.CanQuery = false
                    obj.CastShadow = false
                end
            end
            local hum = clone:FindFirstChildOfClass("Humanoid")
            local root = clone:FindFirstChild("HumanoidRootPart")
            if not hum or not root then clone:Destroy(); return false end
            pcall(function()
                hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                hum.NameDisplayDistance = 0
                hum.HealthDisplayDistance = 0
                hum.BreakJointsOnDeath = false
            end)

            previewWorld = Instance.new("WorldModel")
            previewWorld.Parent = thumbnail
            clone.Parent = previewWorld
            previewClone = clone
            pcall(function() clone:PivotTo(CFrame.new(0, 0, 0)) end)

            -- Frame the complete avatar from its real bounds. Use the rig's own
            -- LookVector to put the camera in front regardless of R6/R15 orientation.
            previewCamera = Instance.new("Camera")
            previewCamera.FieldOfView = 38
            local boxCF, boxSize = clone:GetBoundingBox()
            local focus = boxCF.Position + Vector3.new(0, boxSize.Y * 0.02, 0)
            local rootLook = root.CFrame.LookVector
            local flatLook = Vector3.new(rootLook.X, 0, rootLook.Z)
            if flatLook.Magnitude < 0.01 then flatLook = Vector3.new(0, 0, -1) end
            flatLook = flatLook.Unit
            local halfFov = math.rad(previewCamera.FieldOfView * 0.5)
            local verticalDistance = (boxSize.Y * 0.58) / math.tan(halfFov)
            local horizontalDistance = (boxSize.X * 0.72) / (math.tan(halfFov) * math.max(thumbnail.AbsoluteSize.X / math.max(thumbnail.AbsoluteSize.Y, 1), 0.8))
            local distance = math.max(verticalDistance, horizontalDistance, 7.2)
            local camPos = focus + flatLook * distance + Vector3.new(0, boxSize.Y * 0.035, 0)
            previewCamera.CFrame = CFrame.lookAt(camPos, focus)
            previewCamera.Parent = thumbnail
            thumbnail.CurrentCamera = previewCamera
            return true
        end

