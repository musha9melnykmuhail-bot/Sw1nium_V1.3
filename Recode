    local function stopMiniEQ()
        if miniEQConnection then miniEQConnection:Disconnect(); miniEQConnection = nil end
        for _, bar in ipairs(miniEQBars) do bar.Size = UDim2.new(0, 6, 0, 4) end
    end
    local function startMiniEQ()
        stopMiniEQ()
        local startTime = os.clock()
        miniEQConnection = RunService.RenderStepped:Connect(function()
            local sound = __SW_RadioSound
            if not sound or not sound.Parent or not sound.IsPlaying or miniPaused then stopMiniEQ(); return end
            local loudness = 0
            pcall(function() loudness = sound.PlaybackLoudness end)
            -- PlaybackLoudness follows the actual decoded audio where Roblox exposes it.
            -- A small per-bar phase variation keeps the display readable without fake free-running motion.
            local t = os.clock() - startTime
            local level = math.clamp((tonumber(loudness) or 0) / 450, 0, 1)
            for i, bar in ipairs(miniEQBars) do
                local phase = 0.72 + 0.28 * math.abs(math.sin(t * 8 + i * 0.68))
                local h = math.clamp(3 + level * 20 * phase, 3, 23)
                bar.Size = UDim2.new(0, 6, 0, h)
                bar.BackgroundTransparency = level < 0.015 and 0.35 or 0
            end
        end)
    end
    local function updateMiniTrack(title, assetId)
        miniCurrentTitle = tostring(title or assetId or "Unknown track")
        miniTitle.Text = miniCurrentTitle
        if miniCoverTween then pcall(function() miniCoverTween:Cancel() end) end
        miniCover.ImageTransparency = 1
        -- Roblox's asset thumbnail endpoint may not expose audio covers for every asset.
        miniCover.Image = "rbxthumb://type=Asset&id=" .. tostring(assetId or "0") .. "&w=420&h=420"
        miniCoverTween = TweenService:Create(miniCover, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {ImageTransparency = 0})
        miniCoverTween:Play()
    end
